---
import NeuralBg from '../components/NeuralBg.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'FenX Agency | Création de sites web, vidéos & pub',
  description = "Agence créative pour commerces et TPE partout en France : sites web, vidéos, publicité, branding. Site dès 990€, livré en 7 à 14 jours, prix fixe.",
} = Astro.props;

const siteUrl = 'https://fenx-agency.com';
const ogImage = `${siteUrl}/assets/og-image.jpg`;
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#16161c">
  <meta name="color-scheme" content="dark">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content="création site internet, site internet restaurant, site internet pas cher, vidéo réseaux sociaux, agence web Île-de-France">
  <meta name="author" content="FenX Agency">
  <meta name="robots" content="index, follow, max-image-preview:large">
  <link rel="canonical" href={siteUrl}>

  <!-- Open Graph (Facebook, LinkedIn, WhatsApp, Slack…) -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="FenX Agency">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:url" content={siteUrl}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="FenX Agency · Sites premium pour commerces de proximité">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  <meta name="twitter:image:alt" content="FenX Agency · Sites premium pour commerces de proximité">

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="apple-touch-icon" href="/assets/favicon.svg">

  <!-- Fonts : chargement ASYNCHRONE (non bloquant) + font-display swap. Preconnect limite aux origines des fichiers de police. -->
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin>
  <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=switzer@400,500,700,800,900&display=swap" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;600;700&display=swap" media="print" onload="this.media='all'">
  <noscript>
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=switzer@400,500,700,800,900&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;600;700&display=swap">
  </noscript>
  <link rel="stylesheet" href="/styles.css">

  <!-- Structured data (JSON-LD) @graph : LocalBusiness + FAQPage + Services (SEO agent) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'LocalBusiness',
        '@id': `${siteUrl}/#business`,
        name: 'FenX Agency',
        alternateName: 'Fen X Agency',
        url: siteUrl,
        logo: `${siteUrl}/assets/favicon.svg`,
        image: `${siteUrl}/assets/og-image.jpg`,
        description: description,
        priceRange: '€€',
        email: 'contact.fenx.agency@gmail.com',
        address: {
          '@type': 'PostalAddress',
          addressRegion: 'Île-de-France',
          addressCountry: 'FR',
        },
        areaServed: [
          { '@type': 'AdministrativeArea', name: 'Île-de-France' },
          { '@type': 'Country', name: 'France' },
        ],
        founder: { '@type': 'Person', name: 'Anthony Grupposo' },
        knowsAbout: [
          'Création de sites web',
          'SEO local',
          'Vidéos IA',
          'Branding',
          'Identité visuelle',
        ],
        sameAs: [],
        contactPoint: {
          '@type': 'ContactPoint',
          email: 'contact.fenx.agency@gmail.com',
          contactType: 'Customer Service',
          availableLanguage: ['fr', 'en'],
        },
      },
      {
        '@type': 'WebSite',
        '@id': `${siteUrl}/#website`,
        url: siteUrl,
        name: 'FenX Agency',
        description: description,
        inLanguage: 'fr-FR',
        publisher: { '@id': `${siteUrl}/#business` },
      },
      {
        '@type': 'Service',
        '@id': `${siteUrl}/#service-sites`,
        serviceType: 'Création de site web',
        provider: { '@id': `${siteUrl}/#business` },
        name: 'Site web premium pour TPE',
        description: "Site clé en main pour commerces : référencement Google, espace de gestion autonome, site ultra-rapide sur mobile.",
        areaServed: 'Île-de-France',
        offers: {
          '@type': 'Offer',
          price: '990',
          priceCurrency: 'EUR',
          priceSpecification: {
            '@type': 'PriceSpecification',
            price: '990',
            priceCurrency: 'EUR',
            valueAddedTaxIncluded: false,
          },
        },
      },
      {
        '@type': 'Service',
        '@id': `${siteUrl}/#service-videos`,
        serviceType: 'Production vidéo IA',
        provider: { '@id': `${siteUrl}/#business` },
        name: 'Vidéos IA pour réseaux sociaux',
        description: "Vidéos courtes pour TikTok, Reels et Shorts : à la pièce ou en lot. Voix sur-mesure, montage pro, prêtes à poster.",
        areaServed: 'France',
      },
      {
        '@type': 'Service',
        '@id': `${siteUrl}/#service-branding`,
        serviceType: 'Branding',
        provider: { '@id': `${siteUrl}/#business` },
        name: 'Identité visuelle complète',
        description: "Logo, charte couleurs, kit de marque complet. Cohérence garantie sur tous les supports.",
        areaServed: 'France',
      },
      {
        '@type': 'FAQPage',
        '@id': `${siteUrl}/#faq`,
        mainEntity: [
          {
            '@type': 'Question',
            name: 'Combien ça coûte vraiment ?',
            acceptedAnswer: { '@type': 'Answer', text: "Quatre formules : Vitrine 990€, Démarrage 1990€, Croissance 2990€, Signature sur-mesure (devis prix fixe sous 48h). Vidéo IA : 290€/pièce (pack 3 à 690€). Maintenance : 79€/mois. Jamais d'heures facturées." },
          },
          {
            '@type': 'Question',
            name: 'Combien de temps pour livrer ?',
            acceptedAnswer: { '@type': 'Answer', text: "Site : 7-14 jours à compter de la réception de ton contenu (textes, photos). Vidéo IA : 5 jours. Identité de marque : 4-6 semaines. Pas de créneau immédiat ? On planifie ta date ensemble." },
          },
          {
            '@type': 'Question',
            name: 'Qui maintient le site après ?',
            acceptedAnswer: { '@type': 'Answer', text: "Toi via l'espace de gestion inclus (formation 30 min en visio). Ou pack Maintenance 79€/mois : 2 modifs/mois, suivi Google trimestriel, support sous 48h." },
          },
          {
            '@type': 'Question',
            name: 'Et si je veux modifier moi-même ?',
            acceptedAnswer: { '@type': 'Answer', text: "L'espace de gestion autonome est inclus à partir du Pack Démarrage (1990€) : tu modifies textes, photos, horaires en 2 clics. La formule Vitrine (990€) reste gérée par nous, modifications à la demande." },
          },
          {
            '@type': 'Question',
            name: 'Mon site sera-t-il rapide et bien fait ?',
            acceptedAnswer: { '@type': 'Answer', text: "Oui. On utilise les mêmes technologies que les grands sites pour un site ultra-rapide, sécurisé et bien référencé sur Google. Vous n'avez rien de technique à gérer." },
          },
          {
            '@type': 'Question',
            name: 'Comment se passe le paiement ?',
            acceptedAnswer: { '@type': 'Answer', text: "50% au brief signé, 50% à la livraison. Devis prix fixe (pas d'heures facturées). Paiement par virement ou carte bancaire." },
          },
        ],
      },
    ],
  })} />
</head>
<body>
  <NeuralBg />
  <a href="#main" class="skip-link">Aller au contenu</a>

  {/* V4 Scroll progress bar top 2px (Web Designer agent reco) */}
  <div class="v4-scroll-progress" aria-hidden="true"></div>

  <slot />

  <script is:inline>
    (function () {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const bar = document.querySelector('.v4-scroll-progress');
      if (!bar) return;
      let ticking = false;
      function update() {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? scrollTop / docHeight : 0;
        bar.style.setProperty('--scroll-progress', progress.toFixed(3));
        ticking = false;
      }
      window.addEventListener('scroll', () => {
        if (!ticking) { requestAnimationFrame(update); ticking = true; }
      }, { passive: true });
      update();
    })();
  </script>

  <script is:inline>
    // Disable browser scroll restoration on reload : avoid the "jump to bottom" issue on Firefox hard refresh
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
  </script>

  {/* Lenis smooth scroll — V3.3 reactivated avec params Wibify-like (slow + smooth) */}
  <script>
    import Lenis from 'lenis';

    function initLenis() {
      // Respecte prefers-reduced-motion : pas de smooth scroll
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const lenis = new Lenis({
        duration: 1.4,                          // slow + smooth (Wibify-like)
        easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), // ease out expo
        smoothWheel: true,
        wheelMultiplier: 0.85,                  // mollette légèrement ralentie
        touchMultiplier: 2,                     // touchscreen reste réactif
        infinite: false,
      });

      // RAF loop
      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);

      // Expose pour debug / autres scripts
      (window as any).__lenis = lenis;
    }

    initLenis();
    document.addEventListener('astro:page-load', initLenis);
  </script>

  {/* V5 : scroll-fx migré vers GSAP + ScrollTrigger (TS module Astro-bundlé) */}
  <script>
    import '../scripts/scroll-fx.ts';
  </script>
  <script src="/scripts/pixel-canvas.js" defer is:inline></script>
</body>
</html>
