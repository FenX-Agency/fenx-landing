---
// NeuralBg — fond "neural network" animé global (canvas 2D, derrière tout le contenu).
// - Nœuds reliés (plexus) qui dérivent lentement + pulsent.
// - Impulsions lumineuses qui parcourent aléatoirement les connexions.
// - Hover : les nœuds proches du curseur se déplacent légèrement.
// Placé en position:fixed z-index:-1 ; les sections (--cosmic-bg translucide) le laissent voir.
---
<canvas id="neural-bg" class="neural-bg" aria-hidden="true"></canvas>

<style>
  .neural-bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    display: block;
    pointer-events: none;
    background: #07070d;
  }
</style>

<script>
  function initNeuralBg() {
    const canvas = document.getElementById('neural-bg') as HTMLCanvasElement | null;
    if (!canvas) return;
    if ((canvas as any).__neuralInit) return;
    (canvas as any).__neuralInit = true;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let DPR = Math.min(window.devicePixelRatio || 1, 2);
    let W = 0, H = 0;

    // Palette charte : bleu → violet → rose (selon la position horizontale)
    const BLUE = [59, 130, 246], VIOLET = [139, 107, 255], PINK = [236, 72, 153];
    const lerpC = (a: number[], b: number[], t: number) =>
      [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t];

    type N = { x: number; y: number; bx: number; by: number; vx: number; vy: number; c: number[]; ph: number };
    let nodes: N[] = [];
    const pulses: { a: number; b: number; t: number; speed: number; c: number[] }[] = [];
    const mouse = { x: -9999, y: -9999 };
    let MAXD = 150;

    function build() {
      W = canvas.clientWidth; H = canvas.clientHeight;
      canvas.width = Math.floor(W * DPR); canvas.height = Math.floor(H * DPR);
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      MAXD = Math.max(120, Math.min(170, W / 9));
      const count = Math.max(22, Math.min(110, Math.floor((W * H) / 17000)));
      nodes = [];
      for (let i = 0; i < count; i++) {
        const x = Math.random() * W, y = Math.random() * H;
        const t = x / W;
        const c = t < 0.5 ? lerpC(BLUE, VIOLET, t * 2) : lerpC(VIOLET, PINK, (t - 0.5) * 2);
        nodes.push({
          x, y, bx: x, by: y,
          vx: (Math.random() - 0.5) * 0.14, vy: (Math.random() - 0.5) * 0.14,
          c, ph: Math.random() * Math.PI * 2,
        });
      }
    }

    let raf = 0, time = 0;
    function frame() {
      time += 0.016;
      ctx.clearRect(0, 0, W, H);

      // update nodes : dérive + retour, + déplacement au survol
      for (const n of nodes) {
        n.bx += n.vx; n.by += n.vy;
        if (n.bx < 0 || n.bx > W) n.vx *= -1;
        if (n.by < 0 || n.by > H) n.vy *= -1;
        n.bx = Math.max(0, Math.min(W, n.bx));
        n.by = Math.max(0, Math.min(H, n.by));
        let tx = n.bx, ty = n.by;
        const dx = n.bx - mouse.x, dy = n.by - mouse.y;
        const d2 = dx * dx + dy * dy;
        const R = 170;
        if (d2 < R * R) {
          const d = Math.sqrt(d2) || 1;
          const f = (1 - d / R) * 28;
          tx += (dx / d) * f; ty += (dy / d) * f;
        }
        n.x += (tx - n.x) * 0.09; n.y += (ty - n.y) * 0.09;
      }

      // connexions
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          const dx = a.x - b.x, dy = a.y - b.y;
          const d = Math.hypot(dx, dy);
          if (d < MAXD) {
            const al = (1 - d / MAXD) * 0.32;
            ctx.strokeStyle = `rgba(${(a.c[0] + b.c[0]) / 2 | 0},${(a.c[1] + b.c[1]) / 2 | 0},${(a.c[2] + b.c[2]) / 2 | 0},${al})`;
            ctx.lineWidth = 1.1;
            ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
          }
        }
      }

      // nœuds (pulse)
      for (const n of nodes) {
        const pulse = 0.5 + 0.5 * Math.sin(time * 1.4 + n.ph);
        const r = 1.6 + pulse * 1.6;
        // halo doux
        const glow = ctx.createRadialGradient(n.x, n.y, 0, n.x, n.y, r * 3.2);
        glow.addColorStop(0, `rgba(${n.c[0] | 0},${n.c[1] | 0},${n.c[2] | 0},${0.18 + pulse * 0.22})`);
        glow.addColorStop(1, `rgba(${n.c[0] | 0},${n.c[1] | 0},${n.c[2] | 0},0)`);
        ctx.fillStyle = glow;
        ctx.beginPath(); ctx.arc(n.x, n.y, r * 3.2, 0, Math.PI * 2); ctx.fill();
        // cœur du nœud
        ctx.fillStyle = `rgba(${n.c[0] | 0},${n.c[1] | 0},${n.c[2] | 0},${0.45 + pulse * 0.5})`;
        ctx.beginPath(); ctx.arc(n.x, n.y, r, 0, Math.PI * 2); ctx.fill();
      }

      // impulsions lumineuses qui parcourent les connexions
      if (Math.random() < 0.05 && nodes.length > 1) {
        const a = (Math.random() * nodes.length) | 0;
        let b = -1, best = MAXD;
        for (let j = 0; j < nodes.length; j++) {
          if (j === a) continue;
          const d = Math.hypot(nodes[a].x - nodes[j].x, nodes[a].y - nodes[j].y);
          if (d < best) { best = d; b = j; }
        }
        if (b >= 0) pulses.push({ a, b, t: 0, speed: 0.015 + Math.random() * 0.02, c: nodes[a].c });
      }
      for (let i = pulses.length - 1; i >= 0; i--) {
        const p = pulses[i];
        p.t += p.speed;
        if (p.t >= 1) { pulses.splice(i, 1); continue; }
        const a = nodes[p.a], b = nodes[p.b];
        const x = a.x + (b.x - a.x) * p.t, y = a.y + (b.y - a.y) * p.t;
        const g = ctx.createRadialGradient(x, y, 0, x, y, 7);
        g.addColorStop(0, `rgba(${p.c[0] | 0},${p.c[1] | 0},${p.c[2] | 0},0.95)`);
        g.addColorStop(1, `rgba(${p.c[0] | 0},${p.c[1] | 0},${p.c[2] | 0},0)`);
        ctx.fillStyle = g;
        ctx.beginPath(); ctx.arc(x, y, 7, 0, Math.PI * 2); ctx.fill();
      }

      raf = requestAnimationFrame(frame);
    }

    const start = () => { if (!raf) raf = requestAnimationFrame(frame); };
    const stop = () => { cancelAnimationFrame(raf); raf = 0; };

    build();
    if (reduce) { frame(); stop(); } // rendu statique pour reduced-motion
    else start();

    window.addEventListener('resize', () => { DPR = Math.min(window.devicePixelRatio || 1, 2); build(); }, { passive: true });
    if (!reduce) {
      window.addEventListener('mousemove', (e) => { mouse.x = e.clientX; mouse.y = e.clientY; }, { passive: true });
      window.addEventListener('mouseout', () => { mouse.x = -9999; mouse.y = -9999; }, { passive: true });
      document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); else start(); });
    }
    document.addEventListener('astro:before-swap', () => { stop(); (canvas as any).__neuralInit = false; }, { once: true });
  }

  initNeuralBg();
  document.addEventListener('astro:page-load', initNeuralBg);
</script>
