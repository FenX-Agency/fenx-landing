---
interface Props {
  href: string;
  text: string;
  small?: boolean;
  target?: string;
  rel?: string;
}

const { href, text, small = false, target, rel } = Astro.props;
const classes = small ? 'btn-pill btn-pill-small' : 'btn-pill';
---
<a href={href} class={classes} {...(target && { target })} {...(rel && { rel })}>
  <span class="pixel-canvas-wrapper"><canvas></canvas></span>
  <span class="text">{text}</span>
  <span class="arrow">
    <svg width="20" height="12" viewBox="0 0 20 12" fill="none">
      <path class="arrow-base" d="M0 6 L16 6 M12 1 L16 6 L12 11"
            stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      <path class="arrow-shimmer" d="M0 6 L16 6 M12 1 L16 6 L12 11"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
    </svg>
  </span>
</a>
