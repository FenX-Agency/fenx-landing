---
// HeroShaderBg V3.3 — halo radial volumétrique violet (style Wibify)
// Remplace l'ancien shader "warped bands" qui ne matchait pas Wibify
// Pattern : radial gradient + Perlin noise organique + slow drift + mouse parallax
---
<canvas id="hero-shader-canvas" class="hero-shader-canvas" aria-hidden="true"></canvas>

<style>
  .hero-shader-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-shader-canvas {
      display: none;
    }
  }
</style>

<script>
  import { Renderer, Program, Triangle, Mesh } from 'ogl';

  // ============ Fragment shader (GLSL) ============
  // Halo radial volumétrique organique — inspiré directement de l'effet Wibify
  // visible dans le screen recording : lueur violet qui irradie centre-gauche du Hero
  const fragmentShader = `
    precision highp float;

    uniform float uTime;
    uniform vec2  uResolution;
    uniform vec2  uMouse;
    uniform float uScrollY;
    uniform vec3  uColor;

    varying vec2 vUv;

    // Simplex 2D noise (compact)
    vec3 permute(vec3 x) { return mod(((x*34.0)+1.0)*x, 289.0); }
    float snoise(vec2 v) {
      const vec4 C = vec4(0.211324865405187, 0.366025403784439,
                          -0.577350269189626, 0.024390243902439);
      vec2 i  = floor(v + dot(v, C.yy));
      vec2 x0 = v - i + dot(i, C.xx);
      vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
      vec4 x12 = x0.xyxy + C.xxzz; x12.xy -= i1;
      i = mod(i, 289.0);
      vec3 p = permute(permute(i.y + vec3(0.0, i1.y, 1.0)) + i.x + vec3(0.0, i1.x, 1.0));
      vec3 m = max(0.5 - vec3(dot(x0,x0), dot(x12.xy,x12.xy), dot(x12.zw,x12.zw)), 0.0);
      m = m*m; m = m*m;
      vec3 x = 2.0 * fract(p * C.www) - 1.0;
      vec3 h = abs(x) - 0.5;
      vec3 ox = floor(x + 0.5);
      vec3 a0 = x - ox;
      m *= 1.79284291400159 - 0.85373472095314 * (a0*a0 + h*h);
      vec3 g;
      g.x  = a0.x  * x0.x  + h.x  * x0.y;
      g.yz = a0.yz * x12.xz + h.yz * x12.yw;
      return 130.0 * dot(m, g);
    }

    // Fractal Brownian Motion (layered noise for organic depth)
    float fbm(vec2 p) {
      float v = 0.0;
      float a = 0.5;
      for (int i = 0; i < 4; i++) {
        v += a * snoise(p);
        p *= 2.1;
        a *= 0.55;
      }
      return v;
    }

    void main() {
      // Coords centrées + correction aspect ratio
      vec2 p = vUv * 2.0 - 1.0;
      float aspect = uResolution.x / uResolution.y;
      p.x *= aspect;

      // ====== Halo principal — centre-gauche (où sont placés H1+CTAs) ======
      vec2 haloCenter = vec2(-0.55, 0.05);

      // Slow drift naturel
      haloCenter.x += sin(uTime * 0.13) * 0.08;
      haloCenter.y += cos(uTime * 0.11) * 0.06;

      // Mouse parallax (subtile, 6% influence)
      vec2 mouseInfluence = (uMouse - vec2(0.5)) * 0.06;
      mouseInfluence.x *= aspect;
      haloCenter += mouseInfluence;

      // Distance from halo center + noise distortion (organic shape)
      float dist = distance(p, haloCenter);
      float n1 = fbm(p * 1.3 + uTime * 0.07);
      dist += n1 * 0.22;

      // Soft falloff volumétrique
      float intensity = 1.0 - smoothstep(0.0, 1.55, dist);
      intensity = pow(intensity, 1.4);

      // ====== Couche secondaire — variation noise pour texture ======
      float n2 = fbm(p * 2.5 - uTime * 0.05);
      intensity += n2 * intensity * 0.18;
      intensity = clamp(intensity, 0.0, 1.0);

      // ====== Halo secondaire — petit, plus bas-droite, doux ======
      vec2 halo2Center = vec2(0.4, -0.35);
      halo2Center.x += sin(uTime * 0.18 + 1.5) * 0.08;
      float dist2 = distance(p, halo2Center);
      float intensity2 = (1.0 - smoothstep(0.0, 0.95, dist2)) * 0.35;
      intensity = max(intensity, intensity2);

      // ====== Composition couleur ======
      vec3 cosmicBg = vec3(0.040, 0.040, 0.058);   // #0a0a0f très dark
      vec3 finalColor = mix(cosmicBg, uColor, intensity * 0.85);

      // Subtle vignette périphérie pour focus centre
      float radius = length(p);
      float vignette = 1.0 - smoothstep(1.3, 2.3, radius) * 0.35;
      finalColor *= vignette;

      gl_FragColor = vec4(finalColor, 1.0);
    }
  `;

  const vertexShader = `
    attribute vec2 uv;
    attribute vec2 position;
    varying vec2 vUv;
    void main() {
      vUv = uv;
      gl_Position = vec4(position, 0.0, 1.0);
    }
  `;

  function initHeroShader() {
    const canvas = document.getElementById('hero-shader-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const renderer = new Renderer({
      canvas,
      dpr: Math.min(window.devicePixelRatio || 1, 2),
      alpha: false,
      antialias: false,
    });
    const gl = renderer.gl;

    const geometry = new Triangle(gl);

    const program = new Program(gl, {
      vertex: vertexShader,
      fragment: fragmentShader,
      uniforms: {
        uTime:           { value: 0 },
        uResolution:     { value: [window.innerWidth, window.innerHeight] },
        uMouse:          { value: [0.5, 0.5] },
        uScrollY:        { value: 0 },
        uColor:          { value: [0.655, 0.545, 0.980] }, // #a78bfa violet primary FenX
      },
    });

    const mesh = new Mesh(gl, { geometry, program });

    // Resize handler — robuste
    const resize = () => {
      const parent = canvas.parentElement;
      const w = (parent?.clientWidth) || window.innerWidth;
      const h = (parent?.clientHeight) || window.innerHeight;
      if (w === 0 || h === 0) return;
      renderer.setSize(w, h);
      program.uniforms.uResolution.value = [w, h];
    };
    requestAnimationFrame(() => {
      resize();
      requestAnimationFrame(resize);
    });
    window.addEventListener('resize', resize, { passive: true });
    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(() => resize());
      if (canvas.parentElement) ro.observe(canvas.parentElement);
    }

    // Mouse tracking (lerp smooth)
    const targetMouse = { x: 0.5, y: 0.5 };
    const currentMouse = { x: 0.5, y: 0.5 };
    window.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      targetMouse.x = (e.clientX - rect.left) / rect.width;
      targetMouse.y = 1.0 - (e.clientY - rect.top) / rect.height;
    }, { passive: true });

    let scrollY = 0;
    window.addEventListener('scroll', () => {
      scrollY = window.scrollY;
    }, { passive: true });

    let raf = 0;
    const start = performance.now();
    const tick = () => {
      const t = (performance.now() - start) / 1000;
      program.uniforms.uTime.value = t;
      program.uniforms.uScrollY.value = scrollY;

      currentMouse.x += (targetMouse.x - currentMouse.x) * 0.06;
      currentMouse.y += (targetMouse.y - currentMouse.y) * 0.06;
      program.uniforms.uMouse.value = [currentMouse.x, currentMouse.y];

      renderer.render({ scene: mesh });
      raf = requestAnimationFrame(tick);
    };
    tick();

    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(raf);
    }, { once: true });
  }

  initHeroShader();
  document.addEventListener('astro:page-load', initHeroShader);
</script>
