---
// HeroShaderBg — fragment shader WebGL via OGL
// Inspiré de wibify.agency : warped bands shader avec noise + auto-rotate + mouse + parallax
// Stack : Astro + OGL (50KB, alternative légère à Three.js)
// Params extraits du reverse-engineering Wibify (adaptés palette violette FenX)
---
<canvas id="hero-shader-canvas" class="hero-shader-canvas" aria-hidden="true"></canvas>

<style>
  .hero-shader-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-shader-canvas {
      display: none;
    }
  }
</style>

<script>
  import { Renderer, Program, Triangle, Mesh } from 'ogl';

  // ============ Fragment shader (GLSL) ============
  // Pattern : warped bands + Simplex noise + slow auto-rotation + mouse warp + parallax scroll
  // Couleur signature FenX : violet #a78bfa
  const fragmentShader = `
    precision highp float;

    uniform float uTime;
    uniform vec2  uResolution;
    uniform vec2  uMouse;
    uniform float uScrollY;

    // Wibify-style params (adaptés FenX)
    uniform float uRotation;       // rotation initiale (degrés)
    uniform float uAutoRotate;     // vitesse rotation auto
    uniform float uSpeed;          // vitesse d'animation
    uniform float uFrequency;      // fréquence des bandes
    uniform float uWarpStrength;   // intensité du warp
    uniform float uMouseInfluence; // réaction souris (0-1)
    uniform float uParallax;       // parallax au scroll
    uniform float uNoise;          // intensité du noise
    uniform float uIntensity;      // intensité globale
    uniform float uBandWidth;      // largeur des bandes
    uniform vec3  uColor;          // couleur principale

    varying vec2 vUv;

    // Simplex 2D noise (compact)
    vec3 permute(vec3 x) { return mod(((x*34.0)+1.0)*x, 289.0); }
    float snoise(vec2 v) {
      const vec4 C = vec4(0.211324865405187, 0.366025403784439,
                          -0.577350269189626, 0.024390243902439);
      vec2 i  = floor(v + dot(v, C.yy));
      vec2 x0 = v - i + dot(i, C.xx);
      vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
      vec4 x12 = x0.xyxy + C.xxzz; x12.xy -= i1;
      i = mod(i, 289.0);
      vec3 p = permute(permute(i.y + vec3(0.0, i1.y, 1.0)) + i.x + vec3(0.0, i1.x, 1.0));
      vec3 m = max(0.5 - vec3(dot(x0,x0), dot(x12.xy,x12.xy), dot(x12.zw,x12.zw)), 0.0);
      m = m*m; m = m*m;
      vec3 x = 2.0 * fract(p * C.www) - 1.0;
      vec3 h = abs(x) - 0.5;
      vec3 ox = floor(x + 0.5);
      vec3 a0 = x - ox;
      m *= 1.79284291400159 - 0.85373472095314 * (a0*a0 + h*h);
      vec3 g;
      g.x  = a0.x  * x0.x  + h.x  * x0.y;
      g.yz = a0.yz * x12.xz + h.yz * x12.yw;
      return 130.0 * dot(m, g);
    }

    // Layered fractal noise pour profondeur organique
    float fbm(vec2 p) {
      float v = 0.0;
      float a = 0.5;
      for (int i = 0; i < 3; i++) {
        v += a * snoise(p);
        p *= 2.0;
        a *= 0.5;
      }
      return v;
    }

    void main() {
      // Coords centrées + correction aspect ratio
      vec2 p = vUv * 2.0 - 1.0;
      float aspect = uResolution.x / uResolution.y;
      p.x *= aspect;

      // Mouse influence (cursor warp)
      vec2 mouseCentered = uMouse * 2.0 - 1.0;
      mouseCentered.x *= aspect;
      vec2 mouseDelta = (mouseCentered - p) * uMouseInfluence * 0.06;
      p += mouseDelta;

      // Auto-rotation continue
      float autoAngle = (uRotation + uAutoRotate * uTime * uSpeed * 0.5) * 0.01745329;
      float c = cos(autoAngle);
      float s = sin(autoAngle);
      p = mat2(c, -s, s, c) * p;

      // Parallax scroll (translate Y)
      p.y -= uScrollY * uParallax * 0.0008;

      // Warp via noise
      vec2 warpedP = p;
      float n1 = fbm(p * uFrequency * 1.5 + vec2(uTime * uSpeed * 0.15, 0.0));
      float n2 = fbm(p * uFrequency * 1.5 + vec2(0.0, uTime * uSpeed * 0.1));
      warpedP += vec2(n1, n2) * uWarpStrength * uNoise * 0.4;

      // Bands : sinusoidal pattern selon Y
      float bandValue = sin(warpedP.y * uBandWidth * 3.0 + uTime * uSpeed * 0.3);
      bandValue = bandValue * 0.5 + 0.5;
      bandValue = smoothstep(0.3, 0.85, bandValue);

      // Atténuation radiale depuis le centre (vignette inverse organique)
      float radius = length(p);
      float falloff = 1.0 - smoothstep(0.3, 1.8, radius);

      // Intensité finale
      float val = bandValue * falloff * uIntensity;

      // Composition couleur : violet sur fond cosmic sombre
      vec3 cosmicBg = vec3(0.087, 0.087, 0.110); // #16161c
      vec3 finalColor = mix(cosmicBg, uColor, val * 0.65);

      gl_FragColor = vec4(finalColor, 1.0);
    }
  `;

  const vertexShader = `
    attribute vec2 uv;
    attribute vec2 position;
    varying vec2 vUv;
    void main() {
      vUv = uv;
      gl_Position = vec4(position, 0.0, 1.0);
    }
  `;

  function initHeroShader() {
    const canvas = document.getElementById('hero-shader-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const renderer = new Renderer({
      canvas,
      dpr: Math.min(window.devicePixelRatio || 1, 2),
      alpha: false,
      antialias: false,
    });
    const gl = renderer.gl;

    const geometry = new Triangle(gl); // Full-screen triangle (plus efficace que quad)

    // Params extraits Wibify, adaptés palette FenX violet #a78bfa
    const program = new Program(gl, {
      vertex: vertexShader,
      fragment: fragmentShader,
      uniforms: {
        uTime:           { value: 0 },
        uResolution:     { value: [window.innerWidth, window.innerHeight] },
        uMouse:          { value: [0.5, 0.5] },
        uScrollY:        { value: 0 },
        // Params Wibify-style (Anthony peut tweaker ici)
        uRotation:       { value: 35.0 },
        uAutoRotate:     { value: 1.4 },
        uSpeed:          { value: 0.22 },
        uFrequency:      { value: 1.1 },
        uWarpStrength:   { value: 1.0 },
        uMouseInfluence: { value: 1.0 },
        uParallax:       { value: 0.7 },
        uNoise:          { value: 0.72 },
        uIntensity:      { value: 1.0 },
        uBandWidth:      { value: 3.0 },
        uColor:          { value: [0.655, 0.545, 0.980] }, // #a78bfa violet primary
      },
    });

    const mesh = new Mesh(gl, { geometry, program });

    // Resize handler
    const resize = () => {
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      renderer.setSize(w, h);
      program.uniforms.uResolution.value = [w, h];
    };
    resize();
    window.addEventListener('resize', resize, { passive: true });

    // Mouse tracking (lerp pour smoothness)
    const targetMouse = { x: 0.5, y: 0.5 };
    const currentMouse = { x: 0.5, y: 0.5 };
    window.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      targetMouse.x = (e.clientX - rect.left) / rect.width;
      targetMouse.y = 1.0 - (e.clientY - rect.top) / rect.height;
    }, { passive: true });

    // Scroll tracking (pour parallax)
    let scrollY = 0;
    window.addEventListener('scroll', () => {
      scrollY = window.scrollY;
    }, { passive: true });

    // Animation loop
    let raf = 0;
    const start = performance.now();
    const tick = () => {
      const t = (performance.now() - start) / 1000;
      program.uniforms.uTime.value = t;
      program.uniforms.uScrollY.value = scrollY;

      // Lerp mouse pour smooth
      currentMouse.x += (targetMouse.x - currentMouse.x) * 0.08;
      currentMouse.y += (targetMouse.y - currentMouse.y) * 0.08;
      program.uniforms.uMouse.value = [currentMouse.x, currentMouse.y];

      renderer.render({ scene: mesh });
      raf = requestAnimationFrame(tick);
    };
    tick();

    // Cleanup au unmount (Astro view transitions)
    const cleanup = () => {
      cancelAnimationFrame(raf);
      window.removeEventListener('resize', resize);
    };
    document.addEventListener('astro:before-swap', cleanup, { once: true });
  }

  initHeroShader();
  document.addEventListener('astro:page-load', initHeroShader);
</script>
