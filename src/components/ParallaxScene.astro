---
interface Props {
  id: string;
  videoSrcDesktop?: string;
  videoSrcMobile?: string;
  posterSrc: string;
  eyebrow: string;
  h2: string;
  description: string;
  ctaText: string;
  ctaHref: string;
  ctaExternal?: boolean;
  overlayPosition?: 'left' | 'right' | 'center-top' | 'center-bottom';
  index: number;
}

const {
  id,
  videoSrcDesktop,
  videoSrcMobile,
  posterSrc,
  eyebrow,
  h2,
  description,
  ctaText,
  ctaHref,
  ctaExternal = false,
  overlayPosition = 'left',
  index,
} = Astro.props;

const hasVideo = !!videoSrcDesktop;
const ctaAttrs = ctaExternal ? { target: '_blank', rel: 'noopener' } : {};
---
<section
  id={id}
  class={`parallax-scene parallax-scene--overlay-${overlayPosition} ${hasVideo ? 'has-video' : 'poster-only'}`}
  aria-labelledby={`${id}-title`}
  data-scene-index={index}
>
  <div class="parallax-scene__media">
    <img
      class="parallax-scene__poster"
      src={posterSrc}
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
    />
    {hasVideo && (
      <video
        class="parallax-scene__video"
        data-video-desktop={videoSrcDesktop}
        data-video-mobile={videoSrcMobile || videoSrcDesktop}
        poster={posterSrc}
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
      ></video>
    )}
    <div class="parallax-scene__gradient" aria-hidden="true"></div>
  </div>

  <div class="container parallax-scene__inner">
    <div class="parallax-scene__overlay" data-reveal>
      <span class="parallax-scene__eyebrow">{eyebrow}</span>
      <h2 class="parallax-scene__h2" id={`${id}-title`}>{h2}</h2>
      <p class="parallax-scene__desc">{description}</p>
      <a
        href={ctaHref}
        class="parallax-scene__cta"
        {...ctaAttrs}
      >
        <span>{ctaText}</span>
        <svg width="18" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true">
          <path d="M0 6h15M11 1l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        </svg>
      </a>
    </div>
  </div>
</section>
