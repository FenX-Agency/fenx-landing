---
const WEBHOOK_URL = 'https://n8n.fenx-agency.com/webhook/landing-contact';
---

<div class="contact-modal" data-contact-modal hidden aria-hidden="true" aria-labelledby="contact-modal-title" role="dialog">
  <div class="contact-modal-backdrop" data-contact-modal-close></div>

  <div class="contact-modal-panel" role="document">
    <button
      type="button"
      class="contact-modal-close"
      data-contact-modal-close
      aria-label="Fermer le formulaire"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M5 5L15 15M5 15L15 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>

    <div class="contact-modal-header">
      <span class="contact-modal-eyebrow">Discuter projet</span>
      <h2 class="contact-modal-title" id="contact-modal-title">Parlons de votre projet</h2>
      <p class="contact-modal-sub">Décrivez votre besoin, on revient vers vous sous 24h ouvrées.</p>
    </div>

    <form class="contact-form" data-contact-form data-webhook={WEBHOOK_URL} novalidate>
      <div class="contact-field">
        <label for="contact-nom">Nom complet <span aria-hidden="true">*</span></label>
        <input
          id="contact-nom"
          name="nom"
          type="text"
          autocomplete="name"
          required
          maxlength="100"
          aria-required="true"
        />
        <span class="contact-field-error" data-field-error="nom"></span>
      </div>

      <div class="contact-field">
        <label for="contact-email">Email <span aria-hidden="true">*</span></label>
        <input
          id="contact-email"
          name="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          required
          maxlength="120"
          aria-required="true"
        />
        <span class="contact-field-error" data-field-error="email"></span>
      </div>

      <div class="contact-field">
        <label for="contact-tel">Téléphone <span class="contact-field-optional">(optionnel)</span></label>
        <input
          id="contact-tel"
          name="telephone"
          type="tel"
          autocomplete="tel"
          inputmode="tel"
          maxlength="30"
          placeholder="06 12 34 56 78"
        />
        <span class="contact-field-error" data-field-error="telephone"></span>
      </div>

      <div class="contact-field">
        <label for="contact-message">Votre projet <span aria-hidden="true">*</span></label>
        <textarea
          id="contact-message"
          name="message"
          rows="4"
          required
          maxlength="5000"
          aria-required="true"
          placeholder="Ex : restaurant, ouvert mardi-dimanche, besoin d'un site avec menu et réservation."
        ></textarea>
        <span class="contact-field-error" data-field-error="message"></span>
      </div>

      <p class="contact-form-error" data-form-error hidden></p>

      <div class="contact-form-actions">
        <button type="submit" class="contact-form-submit" data-contact-submit>
          <span data-submit-label>Envoyer la demande</span>
          <span class="contact-form-spinner" data-submit-spinner hidden aria-hidden="true"></span>
        </button>
      </div>
    </form>

    <div class="contact-success" data-contact-success hidden>
      <div class="contact-success-icon" aria-hidden="true">
        <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
          <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
          <path d="M14 24L21 31L34 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <h3 class="contact-success-title">Demande envoyée</h3>
      <p class="contact-success-sub" data-success-message>On revient vers vous sous 24h ouvrées.</p>
      <button type="button" class="contact-success-close" data-contact-modal-close>Fermer</button>
    </div>
  </div>
</div>

<script>
  const modal = document.querySelector<HTMLElement>('[data-contact-modal]');
  if (modal) {
    const form = modal.querySelector<HTMLFormElement>('[data-contact-form]')!;
    const submitBtn = modal.querySelector<HTMLButtonElement>('[data-contact-submit]')!;
    const submitLabel = modal.querySelector<HTMLElement>('[data-submit-label]')!;
    const spinner = modal.querySelector<HTMLElement>('[data-submit-spinner]')!;
    const formErrorEl = modal.querySelector<HTMLElement>('[data-form-error]')!;
    const successEl = modal.querySelector<HTMLElement>('[data-contact-success]')!;
    const successMessageEl = modal.querySelector<HTMLElement>('[data-success-message]')!;
    const webhook = form.dataset.webhook || '';

    const fieldErrorEls: Record<string, HTMLElement> = {};
    modal.querySelectorAll<HTMLElement>('[data-field-error]').forEach((el) => {
      const k = el.getAttribute('data-field-error');
      if (k) fieldErrorEls[k] = el;
    });

    let previouslyFocused: HTMLElement | null = null;

    function openModal() {
      previouslyFocused = document.activeElement as HTMLElement;
      modal!.hidden = false;
      modal!.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      // Reset state on each open
      form.hidden = false;
      successEl.hidden = true;
      clearFieldErrors();
      formErrorEl.hidden = true;
      formErrorEl.textContent = '';
      setTimeout(() => {
        const firstInput = form.querySelector<HTMLInputElement>('input,textarea');
        firstInput?.focus();
      }, 50);
    }

    function closeModal() {
      modal!.hidden = true;
      modal!.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      previouslyFocused?.focus();
    }

    function clearFieldErrors() {
      Object.values(fieldErrorEls).forEach((el) => {
        el.textContent = '';
        el.classList.remove('is-visible');
      });
      form.querySelectorAll<HTMLElement>('.contact-field').forEach((f) => f.classList.remove('has-error'));
    }

    function showFieldError(field: string, msg: string) {
      const el = fieldErrorEls[field];
      if (!el) return;
      el.textContent = msg;
      el.classList.add('is-visible');
      const wrapper = el.closest('.contact-field');
      wrapper?.classList.add('has-error');
    }

    function setLoading(isLoading: boolean) {
      submitBtn.disabled = isLoading;
      submitLabel.style.opacity = isLoading ? '0.5' : '1';
      spinner.hidden = !isLoading;
    }

    function validateClient(): { ok: boolean; data?: Record<string, string> } {
      clearFieldErrors();
      const fd = new FormData(form);
      const nom = String(fd.get('nom') || '').trim();
      const email = String(fd.get('email') || '').trim();
      const telephone = String(fd.get('telephone') || '').trim();
      const message = String(fd.get('message') || '').trim();
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      let ok = true;
      if (!nom) { showFieldError('nom', 'Indiquez votre nom'); ok = false; }
      else if (nom.length > 100) { showFieldError('nom', '100 caractères maximum'); ok = false; }
      if (!email) { showFieldError('email', 'Indiquez votre email'); ok = false; }
      else if (!emailRegex.test(email)) { showFieldError('email', "Email invalide (ex: nom@exemple.fr)"); ok = false; }
      if (telephone && telephone.length > 30) { showFieldError('telephone', '30 caractères maximum'); ok = false; }
      if (!message) { showFieldError('message', 'Décrivez brièvement votre projet'); ok = false; }
      else if (message.length > 5000) { showFieldError('message', '5000 caractères maximum'); ok = false; }
      return ok ? { ok, data: { nom, email, telephone, message } } : { ok };
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const v = validateClient();
      if (!v.ok || !v.data) return;
      formErrorEl.hidden = true;
      formErrorEl.textContent = '';
      setLoading(true);
      try {
        const res = await fetch(webhook, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(v.data),
        });
        let payload: { ok?: boolean; errors?: string[]; message?: string } = {};
        try { payload = await res.json(); } catch { /* ignore */ }
        if (res.ok && payload.ok) {
          form.hidden = true;
          successEl.hidden = false;
          if (payload.message) successMessageEl.textContent = payload.message;
          form.reset();
          successEl.querySelector<HTMLButtonElement>('[data-contact-modal-close]')?.focus();
        } else {
          const errs = payload.errors && payload.errors.length
            ? payload.errors.join(' · ')
            : "Impossible d'envoyer pour le moment. Réessayez ou écrivez à contact.fenx.agency@gmail.com.";
          formErrorEl.textContent = errs;
          formErrorEl.hidden = false;
        }
      } catch {
        formErrorEl.textContent = "Erreur réseau. Vérifiez votre connexion ou écrivez à contact.fenx.agency@gmail.com.";
        formErrorEl.hidden = false;
      } finally {
        setLoading(false);
      }
    });

    document.querySelectorAll<HTMLElement>('[data-open-contact]').forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });

    modal.querySelectorAll<HTMLElement>('[data-contact-modal-close]').forEach((el) => {
      el.addEventListener('click', () => closeModal());
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal!.hidden) closeModal();
    });
  }
</script>
