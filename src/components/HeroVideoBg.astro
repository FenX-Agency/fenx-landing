---
// HeroVideoBg V11 — autoplay natif fluide + hero pinné + zoom d'approche au scroll.
// - La vidéo se lit toute seule en boucle (autoplay natif = parfaitement fluide, toujours vivante).
// - Boucle = fondu noir piloté en JS (propre).
// - Hero pinné : la page ne descend pas ; en scrollant on ZOOME vers le phoenix (approche), sans seek = sans saccade.
interface Props {
  videoSrc?: string;
  poster?: string;
}
const { videoSrc, poster } = Astro.props;
// variante mobile plus légère (ex: /hero.mp4 -> /hero-mobile.mp4), chargée sur petit écran
const videoSrcMobile = videoSrc ? videoSrc.replace(/\.mp4$/, '-mobile.mp4') : undefined;
---
<div class="hero-video-bg" aria-hidden="true" style={poster ? `--hero-poster: url('${poster}')` : undefined}>
  {videoSrc && (
    <video
      id="hero-video"
      class="hero-video-bg__video"
      data-src={videoSrc}
      data-src-mobile={videoSrcMobile}
      poster={poster}
      muted
      playsinline
      preload="auto"
    ></video>
  )}
  <div class="hero-video-bg__black" aria-hidden="true"></div>
</div>

<style>
  .hero-video-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background:
      radial-gradient(75% 65% at 24% 40%, rgba(99, 102, 241, 0.22) 0%, rgba(7, 7, 11, 0) 58%),
      radial-gradient(70% 60% at 82% 60%, rgba(236, 72, 153, 0.14) 0%, rgba(7, 7, 11, 0) 55%),
      #07070b;
    /* fond du hero qui s'estompe en bas → révèle le NeuralBg (fusion avec la section 2) */
    -webkit-mask-image: linear-gradient(to bottom, #000 88%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 88%, transparent 100%);
  }
  .hero-video-bg__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform-origin: 50% 46%; /* zoom vers le phoenix */
    will-change: transform;
  }
  .hero-video-bg__black {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: #000;
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-video-bg__video,
    .hero-video-bg__black { display: none; }
    .hero-video-bg {
      background-image: var(--hero-poster);
      background-size: cover;
      background-position: center;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initHeroVideoBg() {
    const hero = document.getElementById('hero');
    const video = document.getElementById('hero-video') as HTMLVideoElement | null;
    if (!hero || !video) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if ((hero as any).__heroVidInit) return;
    (hero as any).__heroVidInit = true;

    const black = hero.querySelector('.hero-video-bg__black') as HTMLElement | null;

    // ===== Source responsive : variante mobile plus légère sur petit écran =====
    // (le src n'est pas posé en HTML → on évite de charger la version desktop sur mobile)
    if (!video.src) {
      const isMobile = window.matchMedia('(max-width: 768px)').matches;
      const chosen = (isMobile && video.dataset.srcMobile) ? video.dataset.srcMobile : video.dataset.src;
      if (chosen) video.src = chosen;
    }

    // ===== Autoplay natif (lecture fluide, toujours vivante) =====
    video.muted = true;
    video.loop = false; // boucle gérée en JS pour le fondu noir
    const play = () => { video.play().catch(() => {}); };
    play();
    video.addEventListener('canplay', play, { once: true });

    let duration = video.duration || 0;
    const grabDuration = () => { if (!duration && video.duration) duration = video.duration; };
    video.addEventListener('loadedmetadata', grabDuration, { once: true });
    video.addEventListener('durationchange', grabDuration);

    // Sync Lenis <-> ScrollTrigger pour un pin fluide
    const lenis = (window as any).__lenis;
    if (lenis && typeof lenis.on === 'function') lenis.on('scroll', ScrollTrigger.update);

    // ===== Hero pinné + ZOOM d'approche au scroll — DESKTOP ONLY =====
    // matchMedia : sur mobile/tactile (≤768px) on NE pin PAS (sinon le 1er écran de
    // scroll ne fait que zoomer → sensation "bloqué"). La vidéo reste un bg autoplay,
    // la page scrolle normalement. Sur desktop : pin + zoom d'approche.
    const mm = gsap.matchMedia();
    mm.add('(min-width: 769px)', () => {
      const tween = gsap.fromTo(
        video,
        { scale: 1.06 },
        {
          scale: 1.5,
          ease: 'none',
          scrollTrigger: {
            trigger: hero,
            start: 'top top',
            end: '+=110%',
            pin: true,
            pinSpacing: true,
            scrub: 0.6,
            invalidateOnRefresh: true,
          },
        }
      );
      return () => { tween.kill(); };
    });
    // Sur mobile, la vidéo garde un léger zoom statique (pas de scale 1 brut).
    mm.add('(max-width: 768px)', () => {
      gsap.set(video, { scale: 1.06 });
    });

    // ===== Boucle avec fondu noir propre (JS) =====
    const FADE = 0.6;
    let raf = 0;
    const tick = () => {
      if (duration > 0) {
        const t = video.currentTime;
        let o = 0;
        if (t >= duration - FADE) o = (t - (duration - FADE)) / FADE;
        else if (t <= FADE) o = 1 - t / FADE;
        if (t >= duration - 0.04) { try { video.currentTime = 0; } catch (e) {} play(); }
        if (black) black.style.opacity = String(Math.max(0, Math.min(1, o)));
      }
      raf = requestAnimationFrame(tick);
    };
    tick();

    ScrollTrigger.refresh();

    const cleanup = () => {
      cancelAnimationFrame(raf);
      mm.revert();
      (hero as any).__heroVidInit = false;
      document.removeEventListener('astro:before-swap', cleanup);
    };
    document.addEventListener('astro:before-swap', cleanup);
  }

  initHeroVideoBg();
  document.addEventListener('astro:page-load', initHeroVideoBg);
</script>
