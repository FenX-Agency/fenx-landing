---
const year = new Date().getFullYear();
---
<footer class="site-footer fx-footer" aria-labelledby="fx-footer-brand">
  <div class="container fx-footer-inner">
    <!-- TOP : brand + CTA -->
    <div class="fx-footer-top">
      <div class="fx-footer-brand-block">
        <a href="#hero" class="fx-footer-logo" id="fx-footer-brand" aria-label="FenX Agency — retour en haut">
          Fen<span>X</span>
        </a>
        <p class="fx-footer-tagline">
          Des sites et des vidéos qui font venir<br />
          <em>de vrais clients</em> dans votre commerce.
        </p>
      </div>

      <a href="#contact" class="fx-footer-cta">
        <span class="fx-footer-cta-text">On en parle&nbsp;?</span>
        <span class="fx-footer-cta-arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <div class="fx-footer-rule" aria-hidden="true"></div>

    <!-- COLUMNS -->
    <nav class="fx-footer-cols" aria-label="Pied de page">
      <div class="fx-footer-col">
        <h2 class="fx-footer-col-title">Naviguer</h2>
        <ul class="fx-footer-list">
          <li><a href="#selected-work" class="fx-footer-link">Réalisations</a></li>
          <li><a href="#services" class="fx-footer-link">Services</a></li>
          <li><a href="#pricing" class="fx-footer-link">Offres</a></li>
          <li><a href="#process" class="fx-footer-link">Méthode</a></li>
          <li><a href="#faq" class="fx-footer-link">Questions fréquentes</a></li>
        </ul>
      </div>

      <div class="fx-footer-col">
        <h2 class="fx-footer-col-title">Ce qu'on fait</h2>
        <ul class="fx-footer-list">
          <li><a href="#services" class="fx-footer-link">Sites internet</a></li>
          <li><a href="#services" class="fx-footer-link">Vidéos pour réseaux sociaux</a></li>
          <li><a href="#services" class="fx-footer-link">Identité de marque</a></li>
          <li><a href="#services" class="fx-footer-link">Espace de gestion</a></li>
        </ul>
      </div>

      <div class="fx-footer-col fx-footer-col--contact">
        <h2 class="fx-footer-col-title">Parler à Anthony</h2>
        <ul class="fx-footer-list">
          <li>
            <a href="mailto:contact.fenx.agency@gmail.com" class="fx-footer-link fx-footer-link--email">
              contact.fenx.agency@gmail.com
            </a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/anthony-grupposo"
              target="_blank"
              rel="noopener noreferrer"
              class="fx-footer-link fx-footer-link--icon"
              aria-label="Profil LinkedIn d'Anthony Grupposo (nouvel onglet)"
            >
              <svg class="fx-footer-li" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/>
              </svg>
              <span>LinkedIn</span>
              <span class="fx-footer-ext" aria-hidden="true">↗</span>
            </a>
          </li>
        </ul>

        <p class="fx-footer-loc">
          <span class="fx-footer-loc-eyebrow">Où l'on travaille</span>
          Sannois&nbsp;· Île-de-France<br />
          à distance partout en France.
        </p>
      </div>
    </nav>

    <!-- LEGAL BAR -->
    <div class="fx-footer-legal">
      <p class="fx-footer-copyright">
        © {year} <strong>FenX Agency</strong>
      </p>
      <p class="fx-footer-mentions">
        FenX Agency · Auto-entrepreneur · Sannois (95) · TVA non applicable, art. 293&nbsp;B du CGI
      </p>
      <a href="#" class="fx-footer-legal-link">Mentions légales</a>
    </div>
  </div>
</footer>

<style>
  /* ============================================
     Footer — premium rewrite (scoped).
     Uses fx-footer-* classes to avoid the legacy
     global .footer-grid / .footer-col rules in
     public/styles.css. Selectors are specific
     enough to win the cascade on the shared
     .site-footer element.
     ============================================ */

  .fx-footer {
    position: relative;
    /* Translucent dark so the neural canvas reads through subtly. */
    background:
      linear-gradient(
        180deg,
        rgba(14, 14, 20, 0.0) 0%,
        rgba(12, 12, 18, 0.55) 24%,
        rgba(10, 10, 15, 0.82) 100%
      );
    border-top: 1px solid var(--border-subtle);
    padding: 88px 32px 36px;
    overflow: hidden;
  }

  /* Thin brand gradient hairline along the very top edge. */
  .fx-footer::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--violet-primary) 28%,
      var(--ember-500) 72%,
      transparent 100%
    );
    opacity: 0.55;
  }

  /* Soft violet glow blooming from the bottom-left. */
  .fx-footer::after {
    content: "";
    position: absolute;
    bottom: -180px;
    left: -120px;
    width: 460px;
    height: 460px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(139, 107, 255, 0.16) 0%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  .fx-footer-inner {
    position: relative;
    z-index: 1;
  }

  /* ---------- TOP : brand + CTA ---------- */
  .fx-footer-top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
  }

  .fx-footer-brand-block {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 30ch;
  }

  .fx-footer-logo {
    font-family: 'Switzer', sans-serif;
    font-size: clamp(2.6rem, 6vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--text-hover);
    text-decoration: none;
    width: max-content;
  }

  .fx-footer-logo span {
    background-image: linear-gradient(
      135deg,
      var(--violet-soft) 0%,
      var(--violet-primary) 55%,
      var(--ember-500) 120%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--violet-primary);
  }

  .fx-footer-tagline {
    margin: 0;
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    line-height: 1.45;
    color: var(--text-muted);
    font-weight: 500;
  }

  .fx-footer-tagline em {
    font-family: 'Instrument Serif', Georgia, serif;
    font-style: italic;
    font-weight: 400;
    color: var(--lavender-bright);
  }

  /* CTA — pill, brand gradient */
  .fx-footer-cta {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 16px 30px;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--violet-primary), var(--violet-dark));
    color: #ffffff;
    font-family: 'Switzer', sans-serif;
    font-size: 1.0625rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 10px 28px -10px rgba(139, 107, 255, 0.65);
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .fx-footer-cta-arrow {
    display: inline-block;
    transition: transform 220ms ease;
  }

  .fx-footer-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 36px -10px rgba(139, 107, 255, 0.8);
  }

  .fx-footer-cta:hover .fx-footer-cta-arrow {
    transform: translateX(5px);
  }

  /* ---------- rule ---------- */
  .fx-footer-rule {
    height: 1px;
    margin: 52px 0 48px;
    background: linear-gradient(
      90deg,
      var(--border-subtle) 0%,
      rgba(244, 241, 255, 0.04) 100%
    );
  }

  /* ---------- COLUMNS ---------- */
  .fx-footer-cols {
    display: grid;
    grid-template-columns: 1fr 1fr 1.3fr;
    gap: 48px;
  }

  .fx-footer-col {
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-items: flex-start;
  }

  .fx-footer-col-title {
    margin: 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--violet-soft);
  }

  .fx-footer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  /* Link with slide + underline grow micro-interaction */
  .fx-footer-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 0.9375rem;
    line-height: 1.3;
    color: var(--text-muted);
    text-decoration: none;
    width: max-content;
    transition: color 200ms ease, transform 200ms ease;
  }

  .fx-footer-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, var(--violet-soft), var(--ember-500));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .fx-footer-link:hover,
  .fx-footer-link:focus-visible {
    color: var(--text-hover);
    transform: translateX(3px);
  }

  .fx-footer-link:hover::after,
  .fx-footer-link:focus-visible::after {
    transform: scaleX(1);
  }

  .fx-footer-link--email {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875rem;
    letter-spacing: -0.01em;
    word-break: break-word;
  }

  .fx-footer-li {
    flex-shrink: 0;
    color: var(--violet-soft);
    transition: color 200ms ease;
  }

  .fx-footer-link--icon:hover .fx-footer-li {
    color: var(--violet-primary);
  }

  .fx-footer-ext {
    font-size: 0.8em;
    opacity: 0.7;
  }

  /* Location block */
  .fx-footer-loc {
    margin: 6px 0 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .fx-footer-loc-eyebrow {
    display: block;
    margin-bottom: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  /* ---------- LEGAL BAR ---------- */
  .fx-footer-legal {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 24px;
    margin-top: 64px;
    padding-top: 28px;
    border-top: 1px solid var(--border-subtle);
  }

  .fx-footer-copyright {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .fx-footer-copyright strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .fx-footer-mentions {
    margin: 0;
    flex: 1 1 320px;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--text-dim);
  }

  .fx-footer-legal-link {
    font-size: 0.8125rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 200ms ease;
    white-space: nowrap;
  }

  .fx-footer-legal-link:hover,
  .fx-footer-legal-link:focus-visible {
    color: var(--violet-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 900px) {
    .fx-footer-cols {
      grid-template-columns: 1fr 1fr;
      gap: 40px 32px;
    }
    .fx-footer-col--contact {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .fx-footer {
      padding: 64px 24px 32px;
    }
    .fx-footer-top {
      flex-direction: column;
      align-items: stretch;
      gap: 28px;
    }
    .fx-footer-brand-block {
      max-width: none;
    }
    .fx-footer-cta {
      justify-content: center;
      width: 100%;
    }
    .fx-footer-rule {
      margin: 40px 0 36px;
    }
    .fx-footer-cols {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .fx-footer-list {
      gap: 16px; /* taller tap targets on mobile */
    }
    .fx-footer-legal {
      margin-top: 48px;
    }
  }

  /* ---------- REDUCED MOTION ---------- */
  @media (prefers-reduced-motion: reduce) {
    .fx-footer-cta,
    .fx-footer-cta-arrow,
    .fx-footer-link,
    .fx-footer-link::after,
    .fx-footer-li {
      transition: none;
    }
    .fx-footer-cta:hover {
      transform: none;
    }
    .fx-footer-cta:hover .fx-footer-cta-arrow {
      transform: none;
    }
    .fx-footer-link:hover,
    .fx-footer-link:focus-visible {
      transform: none;
    }
    /* Keep the underline affordance but make it instant. */
    .fx-footer-link:hover::after,
    .fx-footer-link:focus-visible::after {
      transform: scaleX(1);
    }
  }
</style>
