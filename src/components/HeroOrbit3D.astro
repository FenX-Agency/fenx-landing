---
// HeroOrbit3D — sphere + torus 3D rendered via OGL
// Inspiré de wibify.agency : rocher Saturne avec anneau qui flotte à droite du Hero
// Stack : Astro + OGL (déjà installé pour HeroShaderBg)
---
<div id="hero-orbit-3d" class="hero-orbit-3d" aria-hidden="true">
  <canvas id="hero-orbit-canvas" class="hero-orbit-3d__canvas"></canvas>
</div>

<style>
  .hero-orbit-3d {
    position: absolute;
    top: 0;
    right: 0;
    width: 55vw;
    max-width: 900px;
    height: 100vh;
    z-index: 2;
    pointer-events: none;
    overflow: visible;
  }

  .hero-orbit-3d__canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  @media (max-width: 1100px) {
    .hero-orbit-3d {
      width: 60vw;
      opacity: 0.5;
    }
  }

  @media (max-width: 768px) {
    .hero-orbit-3d {
      width: 100vw;
      height: 60vh;
      top: 10vh;
      opacity: 0.3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-orbit-3d {
      display: none;
    }
  }
</style>

<script>
  import {
    Renderer, Camera, Transform, Program, Mesh, Sphere, Torus, Vec3
  } from 'ogl';

  function initHeroOrbit3D() {
    const canvas = document.getElementById('hero-orbit-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const renderer = new Renderer({ canvas, dpr, alpha: true, antialias: true });
    const gl = renderer.gl;
    gl.clearColor(0, 0, 0, 0);

    const camera = new Camera(gl, { fov: 35 });
    camera.position.set(0, 0, 5.5);

    const scene = new Transform();

    // ============ Sphere (rocher) ============
    const sphereGeo = new Sphere(gl, { radius: 1.0, widthSegments: 64, heightSegments: 64 });

    const sphereVertex = `
      attribute vec3 position;
      attribute vec3 normal;
      attribute vec2 uv;

      uniform mat4 modelViewMatrix;
      uniform mat4 projectionMatrix;
      uniform mat3 normalMatrix;
      uniform float uTime;

      varying vec3 vNormal;
      varying vec3 vPos;
      varying vec2 vUv;

      // Simplex 3D noise (compact)
      vec3 mod289(vec3 x){ return x - floor(x * (1.0/289.0)) * 289.0; }
      vec4 mod289(vec4 x){ return x - floor(x * (1.0/289.0)) * 289.0; }
      vec4 permute(vec4 x){ return mod289(((x*34.0)+1.0)*x); }
      vec4 taylorInvSqrt(vec4 r){ return 1.79284291400159 - 0.85373472095314 * r; }

      float snoise(vec3 v) {
        const vec2 C = vec2(1.0/6.0, 1.0/3.0);
        const vec4 D = vec4(0.0, 0.5, 1.0, 2.0);
        vec3 i = floor(v + dot(v, C.yyy));
        vec3 x0 = v - i + dot(i, C.xxx);
        vec3 g = step(x0.yzx, x0.xyz);
        vec3 l = 1.0 - g;
        vec3 i1 = min(g.xyz, l.zxy);
        vec3 i2 = max(g.xyz, l.zxy);
        vec3 x1 = x0 - i1 + C.xxx;
        vec3 x2 = x0 - i2 + C.yyy;
        vec3 x3 = x0 - D.yyy;
        i = mod289(i);
        vec4 p = permute(permute(permute(
          i.z + vec4(0.0, i1.z, i2.z, 1.0))
        + i.y + vec4(0.0, i1.y, i2.y, 1.0))
        + i.x + vec4(0.0, i1.x, i2.x, 1.0));
        float n_ = 0.142857142857;
        vec3 ns = n_ * D.wyz - D.xzx;
        vec4 j = p - 49.0 * floor(p * ns.z * ns.z);
        vec4 x_ = floor(j * ns.z);
        vec4 y_ = floor(j - 7.0 * x_);
        vec4 x = x_ *ns.x + ns.yyyy;
        vec4 y = y_ *ns.x + ns.yyyy;
        vec4 h = 1.0 - abs(x) - abs(y);
        vec4 b0 = vec4(x.xy, y.xy);
        vec4 b1 = vec4(x.zw, y.zw);
        vec4 s0 = floor(b0)*2.0 + 1.0;
        vec4 s1 = floor(b1)*2.0 + 1.0;
        vec4 sh = -step(h, vec4(0.0));
        vec4 a0 = b0.xzyw + s0.xzyw*sh.xxyy;
        vec4 a1 = b1.xzyw + s1.xzyw*sh.zzww;
        vec3 p0 = vec3(a0.xy,h.x);
        vec3 p1 = vec3(a0.zw,h.y);
        vec3 p2 = vec3(a1.xy,h.z);
        vec3 p3 = vec3(a1.zw,h.w);
        vec4 norm = taylorInvSqrt(vec4(dot(p0,p0), dot(p1,p1), dot(p2,p2), dot(p3,p3)));
        p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w;
        vec4 m = max(0.6 - vec4(dot(x0,x0), dot(x1,x1), dot(x2,x2), dot(x3,x3)), 0.0);
        m = m * m;
        return 42.0 * dot(m*m, vec4(dot(p0,x0), dot(p1,x1), dot(p2,x2), dot(p3,x3)));
      }

      void main() {
        vUv = uv;
        vec3 pos = position;
        // Surface displacement noise (rocher-like)
        float n = snoise(pos * 1.8 + uTime * 0.05);
        pos += normal * n * 0.12;
        // Output
        vec4 mvPos = modelViewMatrix * vec4(pos, 1.0);
        vPos = mvPos.xyz;
        vNormal = normalize(normalMatrix * normal);
        gl_Position = projectionMatrix * mvPos;
      }
    `;

    const sphereFragment = `
      precision highp float;
      varying vec3 vNormal;
      varying vec3 vPos;
      uniform float uTime;

      void main() {
        // Fresnel rim glow (violet)
        vec3 viewDir = normalize(-vPos);
        float fresnel = pow(1.0 - max(dot(viewDir, vNormal), 0.0), 2.2);
        // Base dark grey rock
        vec3 baseRock = vec3(0.18, 0.16, 0.22);
        // Top light for shading
        float lightTop = max(dot(vNormal, vec3(0.3, 0.7, 0.4)), 0.0);
        vec3 lit = baseRock * (0.5 + lightTop * 0.6);
        // Violet rim glow
        vec3 violet = vec3(0.78, 0.62, 1.0);
        vec3 finalColor = lit + violet * fresnel * 1.4;
        gl_FragColor = vec4(finalColor, 1.0);
      }
    `;

    const sphereProgram = new Program(gl, {
      vertex: sphereVertex,
      fragment: sphereFragment,
      uniforms: { uTime: { value: 0 } },
    });

    const sphereMesh = new Mesh(gl, { geometry: sphereGeo, program: sphereProgram });
    sphereMesh.setParent(scene);

    // ============ Torus (anneau Saturne) ============
    const torusGeo = new Torus(gl, {
      radius: 1.85,
      tube: 0.02,
      radialSegments: 8,
      tubularSegments: 180,
    });

    const torusVertex = `
      attribute vec3 position;
      attribute vec3 normal;
      uniform mat4 modelViewMatrix;
      uniform mat4 projectionMatrix;
      void main() {
        gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
      }
    `;

    const torusFragment = `
      precision highp float;
      void main() {
        // Bright violet ring glow
        gl_FragColor = vec4(0.78, 0.62, 1.0, 0.85);
      }
    `;

    const torusProgram = new Program(gl, {
      vertex: torusVertex,
      fragment: torusFragment,
      transparent: true,
    });

    const torusMesh = new Mesh(gl, { geometry: torusGeo, program: torusProgram });
    torusMesh.rotation.x = Math.PI / 4; // Tilt 45° pour effet Saturne
    torusMesh.rotation.z = -0.15;
    torusMesh.setParent(scene);

    // Resize
    const resize = () => {
      const parent = canvas.parentElement;
      const w = (parent?.clientWidth) || window.innerWidth;
      const h = (parent?.clientHeight) || window.innerHeight;
      if (w === 0 || h === 0) return;
      renderer.setSize(w, h);
      camera.perspective({ aspect: w / h });
    };
    requestAnimationFrame(() => {
      resize();
      requestAnimationFrame(resize);
    });
    window.addEventListener('resize', resize, { passive: true });
    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(() => resize());
      if (canvas.parentElement) ro.observe(canvas.parentElement);
    }

    // Mouse parallax
    const targetMouse = { x: 0, y: 0 };
    window.addEventListener('mousemove', (e) => {
      targetMouse.x = (e.clientX / window.innerWidth - 0.5);
      targetMouse.y = -(e.clientY / window.innerHeight - 0.5);
    }, { passive: true });

    // Scroll
    let scrollY = 0;
    window.addEventListener('scroll', () => { scrollY = window.scrollY; }, { passive: true });

    // Animation loop
    let raf = 0;
    const start = performance.now();
    const currentMouse = { x: 0, y: 0 };
    const tick = () => {
      const t = (performance.now() - start) / 1000;
      sphereProgram.uniforms.uTime.value = t;

      // Lerp mouse
      currentMouse.x += (targetMouse.x - currentMouse.x) * 0.05;
      currentMouse.y += (targetMouse.y - currentMouse.y) * 0.05;

      // Auto rotation
      sphereMesh.rotation.y = t * 0.18 + currentMouse.x * 0.5;
      sphereMesh.rotation.x = currentMouse.y * 0.3;
      torusMesh.rotation.y = t * -0.12 + currentMouse.x * 0.2;

      // Subtle bobbing
      sphereMesh.position.y = Math.sin(t * 0.6) * 0.08;
      torusMesh.position.y = Math.sin(t * 0.6) * 0.08;

      // Scroll parallax (rotation + scale)
      const scrollNorm = Math.min(scrollY / window.innerHeight, 1.0);
      sphereMesh.rotation.z = scrollNorm * 0.4;
      const scale = 1.0 - scrollNorm * 0.15;
      sphereMesh.scale.set(scale, scale, scale);

      renderer.render({ scene, camera });
      raf = requestAnimationFrame(tick);
    };
    tick();

    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(raf);
    }, { once: true });
  }

  initHeroOrbit3D();
  document.addEventListener('astro:page-load', initHeroOrbit3D);
</script>
