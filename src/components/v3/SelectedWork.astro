---
// SelectedWork V3.3 — refonte LISTE style Wibify avec hover preview floating
// Pattern repris : lignes 01/Nom/Tags/Année/↗ + preview thumbnail qui suit le cursor au hover

interface Project {
  num: string;
  title: string;
  tags: string;
  year: string;
  image: string;
  href?: string;
  status: 'live' | 'maintenance';
}

const projects: Project[] = [
  {
    num: '01',
    title: "La Table d'Hugo",
    tags: 'SITE + ESPACE DE GESTION',
    year: '2026',
    image: '/assets/mockup/restauration.webp',
    href: 'https://demo-restaurant.fenx-agency.com',
    status: 'live',
  },
  {
    num: '02',
    title: 'Le Wok du Coin',
    tags: 'SITE + GESTION + GOOGLE',
    year: '2026',
    image: '/assets/mockup/wok.webp',
    href: 'https://demo-wok.fenx-agency.com',
    status: 'live',
  },
  {
    num: '03',
    title: 'Studio beauté',
    tags: 'SITE VITRINE + RÉSERVATION EN LIGNE',
    year: '2026',
    image: '/assets/mockup/atelier.webp',
    status: 'maintenance',
  },
  {
    num: '04',
    title: 'Cabinet médical',
    tags: 'SITE + PRISE DE RDV',
    year: '2026',
    image: '/assets/mockup/cabinet.webp',
    status: 'maintenance',
  },
];
---
<section id="selected-work" class="v3-section v3-selected-work">
  <div class="container">
    <header class="v3-section-head">
      <span class="v3-eyebrow" data-reveal>[02] Réalisations / 2026</span>
      <h2 class="v3-h2" data-reveal style="--reveal-delay: 80ms">
        Ce qu'on a <em>livré</em>.
      </h2>
      <p class="v3-section-sub" data-reveal style="--reveal-delay: 160ms">
        Démos cliquables. <em>Survole pour voir.</em>
      </p>
    </header>

    <ul class="v3-work-list" data-reveal style="--reveal-delay: 240ms">
      {projects.map((p) => {
        const isLive = p.status === 'live';
        const Tag = isLive ? 'a' : 'div';
        const attrs = isLive
          ? { href: p.href!, target: '_blank', rel: 'noopener noreferrer' }
          : {};
        return (
          <li class:list={['v3-work-row', isLive ? 'is-live' : 'is-maintenance']} data-preview={p.image}>
            <Tag class="v3-work-row-link" {...attrs}>
              <span class="v3-work-row-num">{p.num}</span>
              <span class="v3-work-row-title">{p.title}</span>
              <span class="v3-work-row-tags">{p.tags}</span>
              <span class="v3-work-row-year">{p.year}</span>
              <span class="v3-work-row-status" aria-hidden="true">
                {isLive ? '↗' : 'EN MAINTENANCE'}
              </span>
              {/* Image visible uniquement sur mobile (le survol gère le preview sur desktop) */}
              <img class="v3-work-row-thumb" src={p.image} alt={`Aperçu du site ${p.title}`} loading="lazy" />
            </Tag>
          </li>
        );
      })}
    </ul>
  </div>

  {/* Floating preview thumbnail — suit la souris au hover */}
  <div class="v3-work-preview" id="v3-work-preview" aria-hidden="true">
    <img class="v3-work-preview-img" id="v3-work-preview-img" src="" alt="" loading="lazy" />
  </div>
</section>

<!-- Styles globaux V3 · partagés par tous les composants v3/* -->
<style is:global>
  .v3-section {
    padding: var(--pad-section-desktop);
    background: var(--cosmic-bg);
    position: relative;
  }

  @media (max-width: 768px) {
    .v3-section {
      padding: var(--pad-section-mobile);
    }
  }

  .v3-section .container {
    max-width: 1440px; /* V4 : 1280 -> 1440 (Anthony : tout le site prend plus d'espace) */
    margin: 0 auto;
  }

  .v3-section-head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 80px; /* V4 : 64 -> 80 (plus d'air sous le header) */
    max-width: 920px; /* V4 : 760 -> 920 (plus large mais reste readable) */
  }

  @media (max-width: 768px) {
    .v3-section-head {
      margin-bottom: 40px;
      gap: 12px;
    }
  }

  .v3-eyebrow {
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.20em;
    text-transform: uppercase;
    color: var(--violet-primary);
    line-height: 1;
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .v3-eyebrow::before {
    content: '';
    display: inline-block;
    width: 32px;
    height: 1px;
    background: var(--violet-primary);
  }

  @media (max-width: 540px) {
    .v3-eyebrow {
      font-size: 10px;
    }
    .v3-eyebrow::before {
      width: 20px;
    }
  }

  .v3-h2 {
    /* V3.6 : H2 plus imposant (Wibify-like) + line-height qui respire */
    font-size: clamp(3rem, 6vw, 6rem);
    font-weight: 900;
    letter-spacing: -0.035em;
    line-height: 1.05;
    color: var(--text-hover);
    margin: 0;
  }

  .v3-h2 em {
    font-family: 'Instrument Serif', 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-weight: 400;
    color: var(--violet-primary);
    letter-spacing: -0.02em;
  }

  .v3-section-sub {
    font-size: 1.0625rem;
    color: var(--lavender-bright);
    line-height: 1.55;
    margin: 0;
    max-width: 640px;
  }

  .v3-section-sub em {
    color: var(--violet-soft);
    font-style: italic;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .v3-section-sub {
      font-size: 1rem;
    }
  }

  .v3-arrow {
    display: inline-block;
    font-style: normal;
    line-height: 1;
  }
</style>

<style>
  .v3-selected-work {
    position: relative;
  }

  /* Liste de lignes (style Wibify) */
  .v3-work-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border-subtle);
  }

  .v3-work-row {
    border-bottom: 1px solid var(--border-subtle);
    position: relative;
  }

  .v3-work-row-link {
    display: grid;
    grid-template-columns: 60px 1fr auto auto auto;
    align-items: center;
    gap: 32px;
    padding: 32px 8px;
    color: var(--text-muted);
    text-decoration: none;
    transition: padding-left 350ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (max-width: 768px) {
    .v3-work-row-link {
      grid-template-columns: 40px 1fr auto;
      grid-template-rows: auto auto;
      gap: 6px 18px;
      padding: 24px 4px;
    }
  }

  /* Miniature projet : masquée desktop (preview au survol), visible + centrée sur mobile */
  .v3-work-row-thumb {
    display: none;
  }
  @media (max-width: 900px) {
    .v3-work-row-thumb {
      display: block;
      grid-column: 1 / -1;
      width: 100%;
      max-width: 440px;
      margin: 14px auto 2px;
      aspect-ratio: 3 / 2;
      object-fit: cover;
      border-radius: 12px;
      border: 1px solid var(--border-subtle);
    }
    .is-maintenance .v3-work-row-thumb {
      opacity: 0.7;
      filter: grayscale(0.3);
    }
  }

  /* Hover state — Wibify-style : padding shifts right + title brightens */
  .v3-work-row.is-live .v3-work-row-link:hover,
  .v3-work-row.is-live .v3-work-row-link:focus-visible {
    padding-left: 24px;
  }
  .v3-work-row.is-live:hover .v3-work-row-title,
  .v3-work-row.is-live .v3-work-row-link:focus-visible .v3-work-row-title {
    color: var(--text-hover);
  }
  .v3-work-row.is-live:hover .v3-work-row-status,
  .v3-work-row.is-live .v3-work-row-link:focus-visible .v3-work-row-status {
    color: var(--violet-primary);
    transform: translate(4px, -4px);
  }
  .v3-work-row.is-live:hover {
    background: linear-gradient(90deg,
      rgba(167, 139, 250, 0.04) 0%,
      transparent 80%);
  }

  /* Numéro */
  .v3-work-row-num {
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--text-dim);
  }

  /* Titre */
  .v3-work-row-title {
    font-family: 'Switzer', 'Inter', sans-serif;
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--lavender-bright);
    transition: color 250ms ease;
    min-width: 0;
  }

  /* Tags */
  .v3-work-row-tags {
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--text-muted);
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Année */
  .v3-work-row-year {
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-dim);
  }

  /* Status (↗ ou EN MAINTENANCE) */
  .v3-work-row-status {
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
    font-size: 18px;
    font-weight: 600;
    color: var(--text-dim);
    transition: color 250ms ease, transform 250ms ease;
    white-space: nowrap;
  }
  .v3-work-row.is-maintenance .v3-work-row-status {
    font-size: 10px;
    letter-spacing: 0.20em;
    padding: 4px 10px;
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    color: var(--text-dim);
  }
  .v3-work-row.is-maintenance .v3-work-row-link {
    cursor: default;
    opacity: 0.55;
  }

  @media (max-width: 768px) {
    .v3-work-row-tags {
      grid-column: 2 / 4;
      grid-row: 2;
      font-size: 10px;
      letter-spacing: 0.14em;
    }
    .v3-work-row-year {
      display: none;
    }
    .v3-work-row-title {
      font-size: 1.5rem;
    }
    .v3-work-row.is-live .v3-work-row-link:hover {
      padding-left: 12px;
    }
  }

  /* ============ Floating preview thumbnail ============ */
  .v3-work-preview {
    position: fixed;
    top: 0;
    left: 0;
    width: 280px;
    height: 280px;
    border-radius: 14px;
    overflow: hidden;
    pointer-events: none;
    z-index: 100;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.85);
    transition: opacity 220ms ease, transform 380ms cubic-bezier(0.22, 1, 0.36, 1);
    border: 1px solid var(--border-subtle);
    background: var(--cosmic-card);
    box-shadow:
      0 30px 80px -20px rgba(0, 0, 0, 0.65),
      0 0 60px -10px rgba(167, 139, 250, 0.25);
    will-change: transform, opacity;
  }

  .v3-work-preview.is-visible {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  .v3-work-preview-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  @media (max-width: 900px) {
    .v3-work-preview {
      display: none; /* Mobile : pas de preview floating */
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .v3-work-preview {
      transition: opacity 100ms ease;
    }
    .v3-work-row.is-live .v3-work-row-link {
      transition: none;
    }
  }
</style>

<script>
  // Floating preview : suit le cursor + smooth lerp position
  function initSelectedWorkPreview() {
    const preview = document.getElementById('v3-work-preview');
    const previewImg = document.getElementById('v3-work-preview-img') as HTMLImageElement | null;
    if (!preview || !previewImg) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.matchMedia('(max-width: 900px)').matches) return;

    const liveRows = document.querySelectorAll<HTMLElement>('.v3-work-row.is-live');

    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;
    let isHovering = false;
    let currentImage = '';

    const handleMouseMove = (e: MouseEvent) => {
      targetX = e.clientX;
      targetY = e.clientY;
    };

    liveRows.forEach((row) => {
      const image = row.getAttribute('data-preview');
      if (!image) return;

      row.addEventListener('mouseenter', () => {
        if (currentImage !== image) {
          previewImg.src = image;
          currentImage = image;
        }
        isHovering = true;
        preview.classList.add('is-visible');
      });
      row.addEventListener('mouseleave', () => {
        isHovering = false;
        preview.classList.remove('is-visible');
      });
    });

    window.addEventListener('mousemove', handleMouseMove, { passive: true });

    // Animation loop : lerp smooth position
    const tick = () => {
      currentX += (targetX - currentX) * 0.12;
      currentY += (targetY - currentY) * 0.12;
      if (isHovering) {
        preview.style.transform = `translate(${currentX}px, ${currentY}px) translate(-50%, -50%) scale(1)`;
      } else {
        preview.style.transform = `translate(${currentX}px, ${currentY}px) translate(-50%, -50%) scale(0.85)`;
      }
      requestAnimationFrame(tick);
    };
    tick();
  }

  initSelectedWorkPreview();
  document.addEventListener('astro:page-load', initSelectedWorkPreview);
</script>
