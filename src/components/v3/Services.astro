---
// Services V3.3 — refonte cards Wibify-style :
// icon top-left + numéro fantôme géant outline top-right + tags pills monospace
interface Service {
  num: string;
  title: string;
  description: string;
  tags: string[];
  icon: 'monitor' | 'video' | 'star' | 'cog';
  delivery: string;
}

const services: Service[] = [
  {
    num: '01',
    title: 'Sites web',
    description: 'Sites premium pour PME locales. Performance maximale, design moderne, back-office inclus.',
    tags: ['ASTRO · REACT', 'HEADLESS CMS', 'SEO LOCAL', 'A/B TESTING'],
    icon: 'monitor',
    delivery: 'Livré en 7-14 jours',
  },
  {
    num: '02',
    title: 'Vidéos IA',
    description: 'Reels, TikTok, pubs YouTube. Génération IA + voix clonée + motion design pro.',
    tags: ['HIGGSFIELD', 'ELEVENLABS', 'MOTION DESIGN', '9:16 · 16:9'],
    icon: 'video',
    delivery: 'Livrée en 5 jours',
  },
  {
    num: '03',
    title: 'Branding',
    description: 'Identité visuelle complète. Logo, charte, design system éditable. Cohérence garantie.',
    tags: ['LOGO · WORDMARK', 'CHARTE', 'DESIGN SYSTEM', 'FIGMA'],
    icon: 'star',
    delivery: 'Livré en 4-6 sem',
  },
  {
    num: '04',
    title: 'Back-office',
    description: 'Édition de contenu sans dev. Formation 30 min visio. Maintenance optionnelle.',
    tags: ['ÉDITION CMS', 'FORMATION', 'MAINTENANCE 79€/MO', 'SUPPORT 48H'],
    icon: 'cog',
    delivery: 'Inclus dans Pack Premium',
  },
];

const icons = {
  monitor: '<rect x="2" y="3" width="20" height="14" rx="2" stroke-width="1.5"/><path d="M8 21h8M12 17v4" stroke-width="1.5" stroke-linecap="round"/>',
  video: '<rect x="2" y="6" width="14" height="12" rx="2" stroke-width="1.5"/><path d="m22 8-6 4 6 4V8z" stroke-width="1.5" stroke-linejoin="round"/>',
  star: '<path d="M12 2l2.5 6 6.5.5-5 4.5 1.5 6.5L12 16l-5.5 3.5L8 13 3 8.5 9.5 8 12 2z" stroke-width="1.5" stroke-linejoin="round"/>',
  cog: '<circle cx="12" cy="12" r="3" stroke-width="1.5"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" stroke-width="1.5"/>',
};
---
<section id="services" class="v3-section v3-services">
  <div class="container">
    <header class="v3-section-head">
      <span class="v3-eyebrow" data-reveal>[03] Services / Ce qu'on fait</span>
      <h2 class="v3-h2" data-reveal style="--reveal-delay: 80ms">
        Quatre <em>disciplines</em>. Un seul interlocuteur.
      </h2>
      <p class="v3-section-sub" data-reveal style="--reveal-delay: 160ms">
        Pas d'agence sous-traitée, pas d'intermédiaire, pas d'account manager. <em>Direct.</em>
      </p>
    </header>

    <div class="v3-services-grid">
      {services.map((s, idx) => (
        <article
          class="v3-service-card"
          data-reveal
          style={`--reveal-delay: ${220 + idx * 100}ms`}
        >
          {/* Border trace SVG — anime au hover (parcourt moitié + fade out fluide) */}
          <svg class="v3-service-border-trace" viewBox="0 0 400 360" preserveAspectRatio="none" aria-hidden="true">
            <path class="v3-service-border-path v3-service-border-path--tl" d="M 200 0 L 0 0 L 0 180" />
            <path class="v3-service-border-path v3-service-border-path--br" d="M 200 360 L 400 360 L 400 180" />
          </svg>

          {/* Numéro fantôme géant outlined (style Wibify) */}
          <span class="v3-service-ghost-num" aria-hidden="true">{s.num}</span>

          {/* Header : icône + numéro petit */}
          <div class="v3-service-header">
            <span class="v3-service-icon-box" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" set:html={icons[s.icon]}></svg>
            </span>
            <span class="v3-service-num-small">{s.num} / 04</span>
          </div>

          {/* Title + description — H3 avec effet wave inversion couleur au hover */}
          <div class="v3-service-body">
            <h3 class="v3-service-title" data-title={s.title}>
              <span class="v3-service-title-inner">{s.title}</span>
            </h3>
            <p class="v3-service-description">{s.description}</p>
          </div>

          {/* Tags pills monospace */}
          <ul class="v3-service-tags">
            {s.tags.map((tag) => (
              <li class="v3-service-tag">{tag}</li>
            ))}
          </ul>

          {/* Footer : delivery pill + CTA arrow */}
          <div class="v3-service-footer">
            <span class="v3-service-delivery">{s.delivery}</span>
            <a
              href="#contact"
              class="v3-service-cta"
              data-open-contact
              aria-label={`Discuter d'un projet ${s.title.toLowerCase()}`}
            >
              <span class="v3-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .v3-services {
    background: var(--cosmic-bg);
    position: relative;
  }

  .v3-services-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  @media (max-width: 900px) {
    .v3-services-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }

  /* ========== Card ========== */
  .v3-service-card {
    position: relative;
    background: var(--cosmic-card);
    border: 1px solid var(--border-subtle);
    border-radius: 18px;
    padding: 32px 32px 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    transition: transform 450ms cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 450ms ease;
    overflow: hidden;
    min-height: 360px;
  }

  .v3-service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 48px -16px rgba(167, 139, 250, 0.18);
  }

  /* ========== Border trace SVG (style Wibify : parcourt moitié puis fade) ========== */
  .v3-service-border-trace {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
    overflow: visible;
  }
  .v3-service-border-path {
    fill: none;
    stroke: var(--violet-primary);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 380;
    stroke-dashoffset: 380;
    opacity: 0;
    transition: stroke-dashoffset 1000ms cubic-bezier(0.65, 0, 0.35, 1),
                opacity 600ms ease;
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 6px rgba(167, 139, 250, 0.55));
  }
  .v3-service-card:hover .v3-service-border-path {
    stroke-dashoffset: 0;
    opacity: 1;
  }
  /* Fade out fluide après le parcours (au mouse-leave + sur fin du hover) */
  .v3-service-card:hover .v3-service-border-path {
    animation: v3-service-border-trace 1600ms cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }
  .v3-service-card:hover .v3-service-border-path--br {
    animation-delay: 80ms;
  }
  @keyframes v3-service-border-trace {
    0%   { stroke-dashoffset: 380; opacity: 0; }
    20%  { opacity: 1; }
    55%  { stroke-dashoffset: 0; opacity: 1; }
    85%  { opacity: 0.85; }
    100% { stroke-dashoffset: 0; opacity: 0; }
  }

  /* ========== Numéro fantôme géant outlined (style Wibify) ========== */
  .v3-service-ghost-num {
    position: absolute;
    top: -8px;
    right: 18px;
    font-family: 'Inter', sans-serif;
    font-size: 160px;
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--border-subtle);
    text-stroke: 1px var(--border-subtle);
    pointer-events: none;
    user-select: none;
    transition: -webkit-text-stroke-color 400ms ease;
    z-index: 0;
  }

  .v3-service-card:hover .v3-service-ghost-num {
    -webkit-text-stroke-color: rgba(167, 139, 250, 0.35);
  }

  @media (max-width: 900px) {
    .v3-service-ghost-num {
      font-size: 120px;
      top: -4px;
      right: 12px;
    }
  }

  /* ========== Header (icon + num small) ========== */
  .v3-service-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .v3-service-icon-box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    background: rgba(167, 139, 250, 0.10);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    color: var(--violet-primary);
    transition: background 280ms ease, border-color 280ms ease,
                transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  /* Logo rotation 10° au hover (style Wibify) */
  .v3-service-card:hover .v3-service-icon-box {
    background: rgba(167, 139, 250, 0.18);
    border-color: rgba(167, 139, 250, 0.45);
    transform: rotate(10deg);
  }

  .v3-service-num-small {
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--text-dim);
  }

  /* ========== Body ========== */
  .v3-service-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative;
    z-index: 1;
    flex: 1;
  }

  /* H3 wave : 2 couches superposées (texte normal blanc + texte violet en dessous)
     Au hover : le texte blanc sort par le haut, le violet rentre par le bas → effet wave inversion couleur */
  .v3-service-title {
    font-family: 'Inter', sans-serif;
    font-size: clamp(1.75rem, 2.2vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.05;
    color: var(--text-hover);
    margin: 0;
    position: relative;
    display: inline-block;
    overflow: hidden;
    height: 1.05em;
  }
  .v3-service-title-inner {
    display: inline-block;
    transform: translateY(0);
    transition: transform 600ms cubic-bezier(0.76, 0, 0.24, 1);
    will-change: transform;
  }
  .v3-service-title::after {
    content: attr(data-title);
    position: absolute;
    left: 0;
    top: 0;
    color: var(--violet-primary);
    transform: translateY(100%);
    transition: transform 600ms cubic-bezier(0.76, 0, 0.24, 1);
    will-change: transform;
  }
  .v3-service-card:hover .v3-service-title-inner {
    transform: translateY(-105%);
  }
  .v3-service-card:hover .v3-service-title::after {
    transform: translateY(0);
  }

  .v3-service-description {
    font-size: 0.9375rem;
    color: var(--lavender-bright);
    line-height: 1.55;
    margin: 0;
  }

  /* ========== Tags pills monospace ========== */
  .v3-service-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    position: relative;
    z-index: 1;
  }

  .v3-service-tag {
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding: 6px 10px;
    background: rgba(167, 139, 250, 0.06);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    transition: color 250ms ease, border-color 250ms ease, background 250ms ease;
  }

  .v3-service-card:hover .v3-service-tag {
    color: var(--lavender-bright);
    border-color: rgba(167, 139, 250, 0.25);
    background: rgba(167, 139, 250, 0.10);
  }

  /* ========== Footer ========== */
  .v3-service-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 18px;
    border-top: 1px solid var(--border-subtle);
    position: relative;
    z-index: 1;
  }

  .v3-service-delivery {
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--violet-soft);
  }

  .v3-service-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--violet-primary);
    background: rgba(167, 139, 250, 0.08);
    border: 1px solid var(--border-subtle);
    border-radius: 50%;
    text-decoration: none;
    transition: background 250ms ease, border-color 250ms ease, transform 250ms ease;
    font-size: 16px;
  }

  .v3-service-cta:hover {
    background: rgba(167, 139, 250, 0.18);
    border-color: rgba(167, 139, 250, 0.45);
    transform: rotate(-15deg);
  }

  .v3-service-cta .v3-arrow {
    transition: transform 250ms ease;
    display: inline-block;
  }

  .v3-service-cta:hover .v3-arrow {
    transform: translateX(2px);
  }
</style>
