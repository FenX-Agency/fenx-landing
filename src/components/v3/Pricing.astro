---
// Pricing V4 — 3 tiers (Branding + Strategy agents)
// Pack Démarrage 1990€ / Pack Croissance 2990€ / Pack Signature sur-mesure
interface Tier {
  num: string;
  name: string;
  price: string;
  priceUnit: string;
  pitch: string;
  features: string[];
  cta: string;
  featured: boolean;
  badge?: string;
}

const tiers: Tier[] = [
  {
    num: '01',
    name: 'Pack Démarrage',
    price: '1 990',
    priceUnit: '€ HT · paiement 50/50',
    pitch: "Tu lances ton activité ou ton site est obsolète. On livre l'essentiel propre.",
    features: [
      'Site 5 pages sur-mesure',
      'SEO local Google Business',
      'Back-office édition autonome',
      'Formation visio 30 min',
      'Hébergement Cloudflare 12 mois',
      'Support 14 jours après livraison',
    ],
    cta: 'Démarrer le brief',
    featured: false,
  },
  {
    num: '02',
    name: 'Pack Croissance',
    price: '2 990',
    priceUnit: '€ HT · paiement 50/50',
    pitch: "Tu veux booster ton acquisition. Site + branding + premières vidéos IA.",
    features: [
      'Tout le Pack Démarrage',
      'Identité visuelle complète',
      'Charte couleurs + design system',
      '5 vidéos IA réseaux sociaux',
      'Voix clonée (ElevenLabs)',
      'Audit SEO + Google Ads setup',
    ],
    cta: 'Choisir Croissance',
    featured: true,
    badge: 'Le plus choisi',
  },
  {
    num: '03',
    name: 'Pack Signature',
    price: 'Sur mesure',
    priceUnit: 'devis prix fixe sous 48h',
    pitch: "Tu as un projet ambitieux. Réservé : restaurants premium, marques DNVB, cabinets pro.",
    features: [
      'Tout le Pack Croissance',
      'Site sans limite de pages',
      'Animations sur-mesure (WebGL)',
      '20 vidéos IA / mois pendant 3 mois',
      'Maintenance offerte 6 mois',
      'Slack privé Anthony · réponse 4h',
    ],
    cta: 'Discuter sur-mesure',
    featured: false,
  },
];
---
<section id="pricing" class="v3-section v3-pricing">
  <div class="container">
    <header class="v3-section-head">
      <span class="v3-eyebrow" data-reveal>[04] Pricing / Trois packs, prix fixes</span>
      <h2 class="v3-h2" data-reveal style="--reveal-delay: 80ms">
        Tu sais ce que tu paies. <em>Avant</em> de signer.
      </h2>
      <p class="v3-section-sub" data-reveal style="--reveal-delay: 160ms">
        Pas d'heures facturées. Pas de surprise. <em>Devis prix fixe</em>, paiement 50% au brief, 50% à la livraison.
      </p>
    </header>

    <div class="v3-pricing-grid">
      {tiers.map((tier, idx) => (
        <article
          class:list={['v3-pricing-card', tier.featured && 'is-featured']}
          data-reveal
          style={`--reveal-delay: ${220 + idx * 120}ms`}
        >
          {tier.badge && (
            <span class="v3-pricing-badge" aria-hidden="true">{tier.badge}</span>
          )}

          <header class="v3-pricing-card-head">
            <span class="v3-pricing-num">{tier.num} / 03</span>
            <h3 class="v3-pricing-name">{tier.name}</h3>
            <p class="v3-pricing-pitch">{tier.pitch}</p>
          </header>

          <div class="v3-pricing-price-row">
            <span class="v3-pricing-price">{tier.price}</span>
            <span class="v3-pricing-unit">{tier.priceUnit}</span>
          </div>

          <ul class="v3-pricing-features">
            {tier.features.map((f) => (
              <li class="v3-pricing-feature">
                <svg class="v3-pricing-check" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M2 7l3 3 7-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>

          <a
            href="#contact"
            class:list={['v3-pricing-cta', tier.featured && 'is-featured']}
            data-open-contact
          >
            {tier.cta}
            <span class="v3-arrow" aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .v3-pricing {
    background: var(--cosmic-bg);
    position: relative;
  }

  .v3-pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    align-items: stretch;
  }

  @media (max-width: 1100px) {
    .v3-pricing-grid {
      grid-template-columns: 1fr;
      gap: 14px;
      max-width: 560px;
      margin: 0 auto;
    }
  }

  /* ============ Card ============ */
  .v3-pricing-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 28px;
    background: var(--cosmic-card);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 48px 36px 36px;
    transition: border-color 400ms ease, box-shadow 500ms cubic-bezier(0.22, 1, 0.36, 1), transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .v3-pricing-card:hover {
    border-color: rgba(167, 139, 250, 0.3);
    box-shadow: 0 24px 56px -16px rgba(0, 0, 0, 0.5),
                0 0 0 1px rgba(167, 139, 250, 0.18) inset;
    transform: translateY(-4px);
  }

  /* Featured tier (Croissance) — ember accent (Branding agent dual palette) */
  .v3-pricing-card.is-featured {
    background: linear-gradient(180deg, rgba(255, 107, 53, 0.04) 0%, var(--cosmic-card) 60%);
    border-color: rgba(255, 107, 53, 0.32);
    box-shadow: 0 0 32px rgba(255, 107, 53, 0.10),
                0 0 0 1px rgba(255, 107, 53, 0.18) inset;
  }
  .v3-pricing-card.is-featured:hover {
    border-color: rgba(255, 107, 53, 0.55);
    box-shadow: 0 24px 64px -12px rgba(255, 107, 53, 0.30),
                0 0 0 1px rgba(255, 107, 53, 0.40) inset;
  }

  /* Badge "Le plus choisi" — ember pill */
  .v3-pricing-badge {
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%);
    padding: 6px 14px;
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    background: linear-gradient(135deg, var(--ember-500), var(--ember-400));
    border-radius: 100px;
    box-shadow: 0 6px 18px rgba(255, 107, 53, 0.36);
    white-space: nowrap;
  }

  /* ============ Head : num + name + pitch ============ */
  .v3-pricing-card-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .v3-pricing-num {
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--text-dim);
  }

  .v3-pricing-name {
    font-family: 'Switzer', 'Inter', sans-serif;
    font-size: 1.625rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.05;
    color: var(--text-hover);
    margin: 0;
  }

  .v3-pricing-pitch {
    font-size: 0.9375rem;
    color: var(--lavender-bright);
    line-height: 1.55;
    margin: 0;
  }

  /* ============ Price row ============ */
  .v3-pricing-price-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .v3-pricing-price {
    font-family: 'Switzer', 'Inter', sans-serif;
    font-size: 2.75rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--text-hover);
  }
  .v3-pricing-card.is-featured .v3-pricing-price {
    color: var(--ember-400);
  }

  .v3-pricing-unit {
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ============ Features list ============ */
  .v3-pricing-features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .v3-pricing-feature {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.9375rem;
    color: var(--lavender-bright);
    line-height: 1.45;
  }

  .v3-pricing-check {
    flex-shrink: 0;
    margin-top: 4px;
    color: var(--violet-primary);
  }
  .v3-pricing-card.is-featured .v3-pricing-check {
    color: var(--ember-400);
  }

  /* ============ CTA bottom ============ */
  .v3-pricing-cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 22px;
    background: rgba(167, 139, 250, 0.10);
    border: 1px solid rgba(167, 139, 250, 0.24);
    border-radius: 100px;
    color: var(--text-hover);
    font-family: 'Switzer', 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: background 250ms ease, border-color 250ms ease, transform 250ms ease;
    margin-top: auto;
  }

  .v3-pricing-cta:hover {
    background: rgba(167, 139, 250, 0.22);
    border-color: rgba(167, 139, 250, 0.5);
    transform: translateY(-1px);
  }

  .v3-pricing-cta.is-featured {
    background: linear-gradient(135deg, var(--ember-500), var(--ember-400));
    border-color: var(--ember-500);
    color: #fff;
    box-shadow: 0 8px 24px rgba(255, 107, 53, 0.32);
  }
  .v3-pricing-cta.is-featured:hover {
    background: linear-gradient(135deg, var(--ember-400), var(--ember-300));
    box-shadow: 0 12px 32px rgba(255, 107, 53, 0.46);
    transform: translateY(-2px);
  }

  .v3-pricing-cta .v3-arrow {
    transition: transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .v3-pricing-cta:hover .v3-arrow {
    transform: translateX(4px);
  }
</style>
