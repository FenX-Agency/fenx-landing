---
import Button from '../Button.astro';
import PricingModal from './PricingModal.astro';
// Pricing V4 : 4 tiers (Vitrine 990 · Démarrage 1990 · Croissance 2990 · Signature)
interface Tier {
  num: string;
  name: string;
  price: string;
  priceSuffix: string;
  priceUnit: string;
  pitch: string;
  features: string[];
  cta: string;
  featured: boolean;
  variant?: 'blue';
  badge?: string;
}

const tiers: Tier[] = [
  {
    num: '01',
    name: 'Vitrine',
    price: '990',
    priceSuffix: '€ HT',
    priceUnit: 'paiement 50/50',
    pitch: "Tu démarres et tu veux exister sur Google sans te ruiner. L'essentiel, propre et rapide.",
    features: [
      'Site vitrine 1 page',
      'SEO local Google Business',
      'Optimisé mobile, ultra-rapide',
      'Mise en ligne et hébergement 12 mois inclus',
      'Modifications gérées par FenX',
    ],
    cta: 'Commencer petit',
    featured: false,
    variant: 'blue',
    badge: 'Le plus accessible',
  },
  {
    num: '02',
    name: 'Pack Démarrage',
    price: '1 990',
    priceSuffix: '€ HT',
    priceUnit: 'paiement 50/50',
    pitch: "Tu lances ton activité ou ton site est obsolète. On livre l'essentiel propre.",
    features: [
      'Site 5 pages sur-mesure',
      'SEO local Google Business',
      'Espace de gestion autonome',
      'Formation visio 30 min',
      'Mise en ligne et hébergement 12 mois inclus',
      'Support 14 jours après livraison',
    ],
    cta: 'Démarrer le brief',
    featured: false,
  },
  {
    num: '03',
    name: 'Pack Croissance',
    price: '2 990',
    priceSuffix: '€ HT',
    priceUnit: 'paiement 50/50',
    pitch: "Tu veux booster ton acquisition. Site + branding + premières vidéos IA.",
    features: [
      'Tout le Pack Démarrage',
      'Identité visuelle complète',
      'Charte couleurs + design system',
      '3 vidéos IA réseaux sociaux',
      'Voix sur-mesure pour vos vidéos',
      'Référencement Google + campagne pub Google prête',
    ],
    cta: 'Choisir Croissance',
    featured: true,
    badge: 'Le plus choisi',
  },
  {
    num: '04',
    name: 'Pack Signature',
    price: 'Sur mesure',
    priceSuffix: '',
    priceUnit: 'devis prix fixe sous 48h',
    pitch: "Tu as un projet ambitieux. Réservé : restaurants premium, marques en ligne, cabinets et professions libérales.",
    features: [
      'Tout le Pack Croissance',
      'Site sans limite de pages',
      'Animations sur-mesure haut de gamme',
      'Production vidéo IA selon le projet (volume au devis)',
      'Maintenance offerte 6 mois',
      'Ligne directe avec Anthony · réponse en 4h',
    ],
    cta: 'Discuter sur-mesure',
    featured: false,
  },
];
---
<section id="pricing" class="v3-section v3-pricing">
  <div class="container">
    <header class="v3-section-head">
      <span class="v3-eyebrow" data-reveal>[04] Pricing / Quatre formules, prix fixes</span>
      <h2 class="v3-h2" data-reveal style="--reveal-delay: 80ms">
        Tu sais ce que tu paies.<br /><em>Avant</em> de signer.
      </h2>
      <p class="v3-section-sub" data-reveal style="--reveal-delay: 160ms">
        Pas d'heures facturées. Pas de surprise. <em>Devis prix fixe</em>, paiement 50% au brief, 50% à la livraison.
      </p>
    </header>

    <div class="v3-pricing-grid">
      {tiers.slice(0, 3).map((tier, idx) => (
        <article
          class:list={['v3-pricing-card', tier.featured && 'is-featured', tier.variant === 'blue' && 'is-blue']}
          data-reveal
          style={`--reveal-delay: ${220 + idx * 110}ms`}
        >
          {tier.badge && (
            <span class="v3-pricing-badge" aria-hidden="true">{tier.badge}</span>
          )}

          <header class="v3-pricing-card-head">
            <span class="v3-pricing-num">{tier.num} / 04</span>
            <h3 class="v3-pricing-name">{tier.name}</h3>
            <p class="v3-pricing-pitch">{tier.pitch}</p>
          </header>

          <div class="v3-pricing-price-row">
            <div class="v3-pricing-price-main">
              <span class="v3-pricing-price">{tier.price}</span>
              {tier.priceSuffix && (
                <span class="v3-pricing-suffix">{tier.priceSuffix}</span>
              )}
            </div>
            <span class="v3-pricing-unit">{tier.priceUnit}</span>
          </div>

          <ul class="v3-pricing-features">
            {tier.features.map((f) => (
              <li class="v3-pricing-feature">
                <svg class="v3-pricing-check" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M2 7l3 3 7-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>

          <a
            href="#contact"
            class:list={['v3-pricing-cta', tier.featured && 'is-featured', tier.variant === 'blue' && 'is-blue']}
            data-pricing-cta
            data-pack={tier.name}
          >
            {tier.cta}
            <span class="v3-arrow" aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>

    {/* Signature : carte pleine largeur, look premium distinctif (tier le plus haut) */}
    <article class="v3-pricing-signature" data-reveal style="--reveal-delay: 560ms">
      <div class="v3-sig-left">
        <span class="v3-sig-eyebrow">{tiers[3].num} / 04 · Le plus haut de gamme</span>
        <h3 class="v3-sig-name">{tiers[3].name}</h3>
        <p class="v3-sig-pitch">{tiers[3].pitch}</p>
        <div class="v3-sig-price">
          <span class="v3-sig-price-val">{tiers[3].price}</span>
          <span class="v3-sig-price-unit">{tiers[3].priceUnit}</span>
        </div>
        <div class="v3-sig-cta-wrap">
          <Button href="#contact" text={tiers[3].cta} data-pricing-cta data-pack={tiers[3].name} />
        </div>
      </div>
      <div class="v3-sig-right">
        <ul class="v3-sig-features">
          {tiers[3].features.map((f) => (
            <li class="v3-sig-feature">
              <svg width="15" height="15" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2 7l3 3 7-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>{f}</span>
            </li>
          ))}
        </ul>
      </div>
    </article>
  </div>

  <PricingModal />
</section>

<style>
  .v3-pricing {
    background: var(--cosmic-bg);
    position: relative;
  }

  /* Titre forcé sur 2 lignes (br) + sous-titre sur 1 ligne (override scopé Pricing) */
  .v3-pricing .v3-section-head {
    max-width: 1200px;
  }
  .v3-pricing .v3-h2 {
    font-size: clamp(2.4rem, 5vw, 5rem);
    white-space: nowrap;
  }
  .v3-pricing .v3-section-sub {
    max-width: none;
    white-space: nowrap;
  }
  @media (max-width: 900px) {
    .v3-pricing .v3-h2 {
      font-size: clamp(1.9rem, 8vw, 3rem);
      white-space: normal;
    }
    .v3-pricing .v3-section-sub {
      white-space: normal;
    }
  }

  /* 3 cards (Vitrine, Démarrage, Croissance) sur une ligne ; Signature en dessous */
  .v3-pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    align-items: stretch;
  }
  @media (max-width: 960px) {
    .v3-pricing-grid {
      grid-template-columns: 1fr;
      max-width: 460px;
      margin: 0 auto;
    }
  }

  /* ============ Card ============ */
  .v3-pricing-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 24px;
    background: var(--cosmic-card);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 44px 30px 32px;
    transition: border-color 400ms ease, box-shadow 500ms cubic-bezier(0.22, 1, 0.36, 1), transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .v3-pricing-card:hover {
    border-color: rgba(167, 139, 250, 0.3);
    box-shadow: 0 24px 56px -16px rgba(0, 0, 0, 0.5),
                0 0 0 1px rgba(167, 139, 250, 0.18) inset;
    transform: translateY(-4px);
  }

  /* Featured tier (Croissance) : ember accent (Branding agent dual palette) */
  .v3-pricing-card.is-featured {
    background: linear-gradient(180deg, rgba(255, 107, 53, 0.04) 0%, var(--cosmic-card) 60%);
    border-color: rgba(255, 107, 53, 0.32);
    box-shadow: 0 0 32px rgba(255, 107, 53, 0.10),
                0 0 0 1px rgba(255, 107, 53, 0.18) inset;
  }
  .v3-pricing-card.is-featured:hover {
    border-color: rgba(255, 107, 53, 0.55);
    box-shadow: 0 24px 64px -12px rgba(255, 107, 53, 0.30),
                0 0 0 1px rgba(255, 107, 53, 0.40) inset;
  }

  /* Tier Vitrine : accent bleu FenX (#3B82F6) */
  .v3-pricing-card.is-blue {
    background: linear-gradient(180deg, rgba(59, 130, 246, 0.05) 0%, var(--cosmic-card) 60%);
    border-color: rgba(59, 130, 246, 0.35);
    box-shadow: 0 0 32px rgba(59, 130, 246, 0.10),
                0 0 0 1px rgba(59, 130, 246, 0.18) inset;
  }
  .v3-pricing-card.is-blue:hover {
    border-color: rgba(59, 130, 246, 0.6);
    box-shadow: 0 24px 64px -12px rgba(59, 130, 246, 0.30),
                0 0 0 1px rgba(59, 130, 246, 0.40) inset;
  }
  .v3-pricing-card.is-blue .v3-pricing-price,
  .v3-pricing-card.is-blue .v3-pricing-suffix { color: #60A5FA; }
  .v3-pricing-card.is-blue .v3-pricing-check { color: #60A5FA; }
  .v3-pricing-card.is-blue .v3-pricing-badge {
    background: linear-gradient(135deg, #2563EB, #3B82F6);
    box-shadow: 0 6px 18px rgba(59, 130, 246, 0.36);
  }
  .v3-pricing-cta.is-blue {
    background: linear-gradient(135deg, #2563EB, #3B82F6);
    border-color: #2563EB;
    color: #fff;
    box-shadow: 0 8px 24px rgba(59, 130, 246, 0.32);
  }
  .v3-pricing-cta.is-blue:hover {
    background: linear-gradient(135deg, #3B82F6, #60A5FA);
    box-shadow: 0 12px 32px rgba(59, 130, 246, 0.46);
    transform: translateY(-2px);
  }

  /* Badge pill (ember pour Croissance, bleu pour Vitrine) */
  .v3-pricing-badge {
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%);
    padding: 6px 14px;
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    background: linear-gradient(135deg, var(--ember-500), var(--ember-400));
    border-radius: 100px;
    box-shadow: 0 6px 18px rgba(255, 107, 53, 0.36);
    white-space: nowrap;
  }

  /* ============ Head : num + name + pitch ============ */
  .v3-pricing-card-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .v3-pricing-num {
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--text-dim);
  }

  .v3-pricing-name {
    font-family: 'Switzer', 'Inter', sans-serif;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.05;
    color: var(--text-hover);
    margin: 0;
  }

  .v3-pricing-pitch {
    font-size: 0.9375rem;
    color: var(--lavender-bright);
    line-height: 1.55;
    margin: 0;
  }

  /* ============ Price row ============ */
  .v3-pricing-price-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  /* Prix + suffixe "€ HT" sur la même ligne (baseline alignée) */
  .v3-pricing-price-main {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .v3-pricing-price {
    font-family: 'Switzer', 'Inter', sans-serif;
    font-size: 2.55rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--text-hover);
  }
  .v3-pricing-card.is-featured .v3-pricing-price {
    color: var(--ember-400);
  }

  /* Suffixe "€ HT" : à côté du prix, MÊME couleur que le prix */
  .v3-pricing-suffix {
    font-family: 'Switzer', 'Inter', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--text-hover);
  }
  .v3-pricing-card.is-featured .v3-pricing-suffix {
    color: var(--ember-400);
  }

  .v3-pricing-unit {
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ============ Features list ============ */
  .v3-pricing-features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .v3-pricing-feature {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.9375rem;
    color: var(--lavender-bright);
    line-height: 1.45;
  }

  .v3-pricing-check {
    flex-shrink: 0;
    margin-top: 4px;
    color: var(--violet-primary);
  }
  .v3-pricing-card.is-featured .v3-pricing-check {
    color: var(--ember-400);
  }

  /* ============ CTA bottom ============ */
  .v3-pricing-cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 22px;
    background: rgba(167, 139, 250, 0.10);
    border: 1px solid rgba(167, 139, 250, 0.24);
    border-radius: 100px;
    color: var(--text-hover);
    font-family: 'Switzer', 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: background 250ms ease, border-color 250ms ease, transform 250ms ease;
    margin-top: auto;
  }

  .v3-pricing-cta:hover {
    background: rgba(167, 139, 250, 0.22);
    border-color: rgba(167, 139, 250, 0.5);
    transform: translateY(-1px);
  }

  .v3-pricing-cta.is-featured {
    background: linear-gradient(135deg, var(--ember-500), var(--ember-400));
    border-color: var(--ember-500);
    color: #fff;
    box-shadow: 0 8px 24px rgba(255, 107, 53, 0.32);
  }
  .v3-pricing-cta.is-featured:hover {
    background: linear-gradient(135deg, var(--ember-400), var(--ember-300));
    box-shadow: 0 12px 32px rgba(255, 107, 53, 0.46);
    transform: translateY(-2px);
  }

  .v3-pricing-cta .v3-arrow {
    transition: transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .v3-pricing-cta:hover .v3-arrow {
    transform: translateX(4px);
  }

  /* ============ Carte Signature (pleine largeur, premium) ============ */
  .v3-pricing-signature {
    position: relative;
    margin-top: 16px;
    display: flex;
    align-items: center;
    gap: clamp(28px, 4vw, 64px);
    padding: clamp(32px, 4vw, 52px) clamp(28px, 4vw, 56px);
    border-radius: 20px;
    background:
      radial-gradient(120% 160% at 0% 0%, rgba(139, 107, 255, 0.12), transparent 55%),
      radial-gradient(120% 160% at 100% 100%, rgba(255, 107, 53, 0.10), transparent 55%),
      linear-gradient(180deg, #15151d 0%, #0e0e14 100%);
    overflow: hidden;
    transition: transform 650ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .v3-pricing-signature:hover {
    transform: translateY(-3px);
    box-shadow:
      0 26px 60px -26px rgba(0, 0, 0, 0.55),
      0 0 44px -16px rgba(139, 107, 255, 0.22),
      0 0 72px -30px rgba(255, 107, 53, 0.14);
  }
  .v3-pricing-signature::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 20px;
    padding: 1.5px;
    background: linear-gradient(120deg, rgba(139, 107, 255, 0.6), rgba(255, 107, 53, 0.5));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    pointer-events: none;
    transition: background 650ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .v3-pricing-signature:hover::before {
    background: linear-gradient(120deg, rgba(139, 107, 255, 0.7), rgba(255, 107, 53, 0.6));
  }

  .v3-sig-left {
    flex: 0 0 38%;
    max-width: 420px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .v3-sig-cta-wrap {
    margin-top: 6px;
  }
  .v3-sig-eyebrow {
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--violet-soft, #a78bfa);
  }
  .v3-sig-name {
    font-family: 'Instrument Serif', Georgia, serif;
    font-weight: 400;
    font-size: clamp(2.2rem, 3.4vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--text-hover, #ffffff);
    margin: 0;
  }
  .v3-sig-pitch {
    font-size: 0.95rem;
    color: var(--lavender-bright, #c9c2e8);
    line-height: 1.55;
    margin: 0;
  }
  .v3-sig-price {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 4px 0 0;
    flex-wrap: wrap;
  }
  .v3-sig-price-val {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: 2rem;
    color: #ffffff;
    line-height: 1;
  }
  .v3-sig-price-unit {
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted, #8b8ba0);
  }
  .v3-sig-cta {
    margin-top: 24px;
    display: inline-flex;
    width: auto;
    background: linear-gradient(120deg, var(--violet-primary, #8b6bff), var(--ember-500, #ff6b35));
    border-color: transparent;
    color: #ffffff;
    box-shadow: 0 10px 30px rgba(139, 107, 255, 0.28);
  }
  .v3-sig-cta:hover {
    box-shadow: 0 14px 38px rgba(255, 107, 53, 0.34);
    transform: translateY(-2px);
  }

  .v3-sig-right {
    flex: 1 1 auto;
  }
  .v3-sig-features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 28px;
  }
  .v3-sig-feature {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.95rem;
    color: var(--lavender-bright, #c9c2e8);
    line-height: 1.4;
  }
  .v3-sig-feature svg {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--ember-400, #ff8a5c);
  }

  @media (max-width: 860px) {
    .v3-pricing-signature {
      flex-direction: column;
      align-items: stretch;
      gap: 28px;
    }
    .v3-sig-left { flex-basis: auto; max-width: none; }
    .v3-sig-features { grid-template-columns: 1fr; }
    .v3-sig-cta { width: 100%; justify-content: space-between; }
  }
</style>
