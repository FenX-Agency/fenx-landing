---
// Process V3.3 — refonte rows horizontales split 50/50 (style Wibify)
// Layout : illustration 3D blueprint gauche / texte+tags droite, 4 phases stacked

interface Phase {
  num: string;
  title: string;
  description: string;
  tags: string[];
  image: string;
  imageAlt: string;
}

const phases: Phase[] = [
  {
    num: '01',
    title: 'Brief',
    description: "On démarre par 30 minutes en visio pour cerner ton projet. Analyse concurrence, audit de l'existant, roadmap chiffrée et devis fixe — pas d'heures facturées.",
    tags: ['BRIEF VISIO 30MIN', 'ANALYSE CONCURRENCE', 'ROADMAP CHIFFRÉE', 'DEVIS FIXE'],
    image: '/assets/process/brief.webp',
    imageAlt: 'Diamant cristal flottant avec orbites — illustration blueprint Brief',
  },
  {
    num: '02',
    title: 'Design',
    description: "Wireframes interactifs Figma, UI premium dark mode violet, prototype cliquable. Validation en deux itérations maximum — ensuite on passe au code.",
    tags: ['WIREFRAMES INTERACTIFS', 'UI PREMIUM', 'DESIGN SYSTEM', '2 ITÉRATIONS MAX'],
    image: '/assets/process/design.webp',
    imageAlt: 'Cône cristal blanc avec orbites — illustration blueprint Design',
  },
  {
    num: '03',
    title: 'Build',
    description: "Code en Astro 5 + React 19 + TypeScript. Performance Lighthouse 95 minimum. SEO local intégré, schema.org, tests sur Chrome / Safari / Firefox.",
    tags: ['ASTRO 5 + REACT 19', 'LIGHTHOUSE 95+', 'SEO LOCAL', 'TESTS CROSS-BROWSER'],
    image: '/assets/process/build.webp',
    imageAlt: 'Cube isométrique 3D wireframe — illustration blueprint Build',
  },
  {
    num: '04',
    title: 'Launch',
    description: "Mise en ligne en 24 heures sur Cloudflare. Formation back-office 30 min en visio. Quatorze jours de support gratuit après livraison.",
    tags: ['MISE EN LIGNE 24H', 'FORMATION VISIO', 'SUPPORT 14J OFFERTS', 'MAINTENANCE OPT.'],
    image: '/assets/process/launch.webp',
    imageAlt: 'Orbe sphérique avec trajectory — illustration blueprint Launch',
  },
];
---
<section id="process" class="v3-section v3-process">
  <div class="container">
    <header class="v3-section-head">
      <span class="v3-eyebrow" data-reveal>[04] Process / Comment on bosse</span>
      <h2 class="v3-h2" data-reveal style="--reveal-delay: 80ms">
        Du <em>brief</em> au <em>launch</em>.
      </h2>
      <p class="v3-section-sub" data-reveal style="--reveal-delay: 160ms">
        Quatre étapes claires. Pas d'aller-retour interminable, pas de <em>scope creep</em>.
      </p>
    </header>

    <ol class="v3-process-list">
      {phases.map((phase, idx) => (
        <li
          class="v3-process-row"
          data-reveal
          style={`--reveal-delay: ${240 + idx * 100}ms; --row-index: ${idx}; z-index: ${idx + 1};`}
        >
          <div class="v3-process-row-visual">
            <img
              src={phase.image}
              alt={phase.imageAlt}
              class="v3-process-row-img"
              loading="lazy"
              decoding="async"
              width="1280"
              height="1280"
            />
          </div>
          <div class="v3-process-row-content">
            <span class="v3-process-row-num">{phase.num} / 04</span>
            <h3 class="v3-process-row-title">{phase.title}</h3>
            <p class="v3-process-row-description">{phase.description}</p>
            <ul class="v3-process-row-tags">
              {phase.tags.map((tag) => (
                <li class="v3-process-row-tag">{tag}</li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .v3-process {
    background: var(--cosmic-bg);
    position: relative;
  }

  /* Liste de phases — STICKY STACKING (style Wibify v3) */
  .v3-process-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 24px; /* V3.5 : 32 -> 24 (gap rows plus serre Wibify-like) */
    position: relative;
  }

  @media (max-width: 768px) {
    .v3-process-list {
      gap: 18px;
    }
  }

  /* ============ Row split 50/50 — STICKY au scroll avec offset progressif ============ */
  /* Chaque row se colle au top avec un offset croissant → les rows s'empilent visuellement au scroll */
  .v3-process-row {
    position: sticky;
    top: calc(80px + var(--row-index, 0) * 28px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0;
    background: linear-gradient(180deg, var(--cosmic-card) 0%, #14141c 100%);
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    overflow: hidden;
    transition: border-color 350ms ease;
    box-shadow: 0 -1px 0 rgba(167, 139, 250, 0.06),
                0 24px 60px -16px rgba(0, 0, 0, 0.85);
  }

  /* Désactive le sticky sur mobile (pas de space pour le stacking) + reduced-motion */
  @media (max-width: 900px) {
    .v3-process-row {
      position: relative;
      top: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .v3-process-row {
      position: relative;
      top: auto;
    }
  }

  .v3-process-row:hover {
    border-color: rgba(167, 139, 250, 0.2);
    background: rgba(28, 28, 46, 0.55);
  }

  @media (max-width: 900px) {
    .v3-process-row {
      grid-template-columns: 1fr;
    }
  }

  /* ============ Visuel illustration 3D blueprint ============ */
  .v3-process-row-visual {
    position: relative;
    aspect-ratio: 16 / 10; /* V3.5 : 1:1 -> 16:10 (allonge horizontal Wibify-like) */
    min-height: 380px;
    background: radial-gradient(
      ellipse at center,
      rgba(167, 139, 250, 0.04) 0%,
      transparent 70%
    ), #000;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .v3-process-row-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
    filter: brightness(0.95);
  }

  .v3-process-row:hover .v3-process-row-img {
    transform: scale(1.04);
    filter: brightness(1.05);
  }

  @media (max-width: 900px) {
    .v3-process-row-visual {
      aspect-ratio: 16 / 10;
    }
  }

  /* ============ Content droite ============ */
  .v3-process-row-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(40px, 5vw, 80px); /* V3.5 : 32-56 -> 40-80 (plus genereux Wibify-like) */
    gap: 24px;
  }

  .v3-process-row-num {
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.20em;
    color: var(--text-dim);
  }

  .v3-process-row-title {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2rem, 3.2vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.0;
    color: var(--text-hover);
    margin: 0;
  }

  .v3-process-row-description {
    font-size: 0.9375rem;
    color: var(--lavender-bright);
    line-height: 1.6;
    margin: 0;
  }

  /* Tags pills monospace */
  .v3-process-row-tags {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .v3-process-row-tag {
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding: 6px 10px;
    background: rgba(167, 139, 250, 0.06);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    transition: color 250ms ease, border-color 250ms ease;
  }

  .v3-process-row:hover .v3-process-row-tag {
    color: var(--lavender-bright);
    border-color: rgba(167, 139, 250, 0.25);
  }

  @media (max-width: 540px) {
    .v3-process-row-content {
      padding: 28px 24px 32px;
      gap: 14px;
    }
    .v3-process-row-title {
      font-size: 1.75rem;
    }
    .v3-process-row-tag {
      font-size: 9px;
      letter-spacing: 0.08em;
    }
  }
</style>
