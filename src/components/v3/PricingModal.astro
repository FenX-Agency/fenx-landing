---
// Modal unique, consciente du pack cliqué. Ouverte par les CTA [data-pricing-cta].
// Envoie au meme webhook n8n que le formulaire Contact + un champ `pack`.
const WEBHOOK_URL = 'https://n8n.fenx-agency.com/webhook/landing-contact';
---
<div class="pm-overlay" id="pricing-modal" hidden>
  <div class="pm-backdrop" data-pm-close aria-hidden="true"></div>
  <div class="pm-dialog" role="dialog" aria-modal="true" aria-labelledby="pm-title">
    <button class="pm-close" type="button" aria-label="Fermer" data-pm-close>
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>

    <span class="pm-eyebrow" id="pm-eyebrow">Formule</span>
    <h3 class="pm-title" id="pm-title">Parlons de ton projet</h3>
    <p class="pm-sub" id="pm-sub">Réponse sous 24h, sans engagement.</p>

    <form class="pm-form" id="pm-form" data-webhook={WEBHOOK_URL} novalidate>
      <input type="hidden" name="pack" id="pm-pack" value="" />
      <div class="pm-grid">
        <label class="pm-field">Prénom
          <input name="prenom" type="text" autocomplete="given-name" placeholder="Marie" required />
        </label>
        <label class="pm-field">Nom
          <input name="nom_famille" type="text" autocomplete="family-name" placeholder="Durand" required />
        </label>
      </div>
      <label class="pm-field">Email
        <input name="email" type="email" autocomplete="email" placeholder="marie@exemple.fr" required />
      </label>
      <label class="pm-field">Téléphone
        <input name="telephone" type="tel" autocomplete="tel" placeholder="06 12 34 56 78" required />
      </label>
      <label class="pm-field">Ton projet en deux mots (optionnel)
        <textarea name="message" rows="3" placeholder="Ex. un site vitrine pour mon salon à Sannois"></textarea>
      </label>
      <button class="btn-pill pm-submit" type="submit">
        <span class="text">Envoyer ma demande</span>
      </button>
      <p class="pm-foot" id="pm-foot">Réponse sous 24h. Zéro spam, zéro engagement.</p>
      <p class="pm-status" id="pm-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</div>

<style>
  .pm-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .pm-overlay[hidden] { display: none; }
  .pm-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(5, 5, 9, 0.72);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 280ms ease;
  }
  .pm-dialog {
    position: relative;
    width: 100%;
    max-width: 480px;
    max-height: calc(100vh - 48px);
    overflow-y: auto;
    padding: clamp(28px, 4vw, 40px);
    border-radius: 20px;
    background:
      radial-gradient(120% 120% at 0% 0%, rgba(139, 107, 255, 0.10), transparent 55%),
      linear-gradient(180deg, #15151d 0%, #0e0e14 100%);
    border: 1px solid rgba(167, 139, 250, 0.22);
    box-shadow: 0 50px 120px -30px rgba(0, 0, 0, 0.85), 0 0 70px -22px rgba(139, 107, 255, 0.22);
    transform: translateY(14px) scale(0.98);
    opacity: 0;
    transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1), opacity 300ms ease;
  }
  .pm-overlay.is-open .pm-backdrop { opacity: 1; }
  .pm-overlay.is-open .pm-dialog { transform: translateY(0) scale(1); opacity: 1; }

  .pm-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    color: #c9c2e8;
    cursor: pointer;
    transition: background 200ms ease, color 200ms ease;
  }
  .pm-close:hover { background: rgba(255, 255, 255, 0.1); color: #fff; }

  .pm-eyebrow {
    display: inline-block;
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #c4b5fd;
    padding: 6px 12px;
    border-radius: 100px;
    background: rgba(139, 107, 255, 0.12);
    border: 1px solid rgba(139, 107, 255, 0.28);
  }
  .pm-title {
    font-family: 'Instrument Serif', Georgia, serif;
    font-weight: 400;
    font-size: clamp(1.9rem, 3.4vw, 2.4rem);
    line-height: 1.08;
    color: #fff;
    margin: 16px 0 0;
  }
  .pm-sub {
    font-size: 0.95rem;
    color: #c9c2e8;
    line-height: 1.5;
    margin: 8px 0 0;
  }

  .pm-form { margin-top: 22px; display: flex; flex-direction: column; gap: 14px; }
  .pm-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .pm-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8b8ba0;
  }
  .pm-field input,
  .pm-field textarea {
    font-family: 'Switzer', 'Inter', sans-serif;
    font-size: 15px;
    text-transform: none;
    letter-spacing: 0;
    color: #fff;
    width: 100%;
    background: #1c1c26;
    border: 1px solid rgba(167, 139, 250, 0.30);
    border-radius: 11px;
    padding: 13px 14px;
    transition: border-color 200ms ease, box-shadow 200ms ease, background 200ms ease;
  }
  .pm-field textarea { resize: vertical; min-height: 70px; }
  .pm-field input::placeholder,
  .pm-field textarea::placeholder { color: #6b6b80; }
  .pm-field input:focus,
  .pm-field textarea:focus {
    outline: none;
    border-color: #8b6bff;
    background: #20202c;
    box-shadow: 0 0 0 3px rgba(139, 107, 255, 0.18);
  }
  .pm-field input.is-invalid,
  .pm-field textarea.is-invalid { border-color: #f87171; }

  .pm-submit {
    margin-top: 6px;
    width: 100%;
    justify-content: center;
  }
  .pm-foot { font-size: 12px; color: #8b8ba0; text-align: center; margin: 2px 0 0; }
  .pm-status { font-size: 13px; margin: 2px 0 0; min-height: 16px; text-align: center; }
  .pm-status.is-error { color: #f87171; }
  .pm-status.is-ok { color: #4ade80; }

  @media (max-width: 460px) {
    .pm-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pm-backdrop, .pm-dialog { transition: none; }
  }
</style>

<script>
  const PACKS: Record<string, { eyebrow: string; title: string; sub: string; delay: string }> = {
    'Vitrine': {
      eyebrow: 'Formule Vitrine · 990€',
      title: 'Parlons de ta Vitrine',
      sub: 'Ton site vitrine + référencement local, livré vite. On cadre tout en 15 minutes, sans engagement.',
      delay: '24h',
    },
    'Pack Démarrage': {
      eyebrow: 'Pack Démarrage · 1990€',
      title: 'Parlons de ton Pack Démarrage',
      sub: 'Site 5 pages sur-mesure + espace de gestion autonome. Dis-nous où tu en es.',
      delay: '24h',
    },
    'Pack Croissance': {
      eyebrow: 'Pack Croissance · 2990€',
      title: 'Parlons de ton Pack Croissance',
      sub: 'Site + branding + vidéos IA. Voyons ensemble ton plan d’acquisition.',
      delay: '48h',
    },
    'Pack Signature': {
      eyebrow: 'Pack Signature · sur-mesure',
      title: 'Parlons de ton projet Signature',
      sub: 'Sur-mesure, sans limite. Décris-nous ton ambition, on te répond avec un devis sous 48h.',
      delay: '48h',
    },
  };
  const DEFAULT = { eyebrow: 'Ton projet', title: 'Parlons de ton projet', sub: 'Sans engagement.', delay: '24h' };

  const overlay = document.getElementById('pricing-modal');
  if (overlay) {
    const dialog = overlay.querySelector('.pm-dialog') as HTMLElement;
    const form = document.getElementById('pm-form') as HTMLFormElement;
    const elEyebrow = document.getElementById('pm-eyebrow')!;
    const elTitle = document.getElementById('pm-title')!;
    const elSub = document.getElementById('pm-sub')!;
    const elPack = document.getElementById('pm-pack') as HTMLInputElement;
    const elFoot = document.getElementById('pm-foot')!;
    const elStatus = document.getElementById('pm-status')!;
    let lastFocused: HTMLElement | null = null;

    function openModal(pack: string) {
      const cfg = PACKS[pack] || DEFAULT;
      elEyebrow.textContent = cfg.eyebrow;
      elTitle.textContent = cfg.title;
      elSub.textContent = cfg.sub;
      elFoot.textContent = 'Réponse sous ' + cfg.delay + '. Zéro spam, zéro engagement.';
      elPack.value = pack || '';
      elStatus.textContent = '';
      elStatus.className = 'pm-status';
      lastFocused = document.activeElement as HTMLElement;
      overlay.hidden = false;
      // force reflow then animate
      void overlay.offsetWidth;
      overlay.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      try { (window as any).__lenis?.stop(); } catch {}
      const first = form.querySelector('input') as HTMLInputElement;
      setTimeout(() => first?.focus(), 60);
      document.addEventListener('keydown', onKey);
    }
    function closeModal() {
      overlay.classList.remove('is-open');
      document.body.style.overflow = '';
      try { (window as any).__lenis?.start(); } catch {}
      document.removeEventListener('keydown', onKey);
      setTimeout(() => { overlay.hidden = true; }, 320);
      lastFocused?.focus();
    }
    function onKey(e: KeyboardEvent) {
      if (e.key === 'Escape') closeModal();
      if (e.key === 'Tab') {
        const f = dialog.querySelectorAll<HTMLElement>('a[href],button,input,textarea,select,[tabindex]:not([tabindex="-1"])');
        if (!f.length) return;
        const first = f[0], last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    }

    document.querySelectorAll<HTMLElement>('[data-pricing-cta]').forEach((cta) => {
      cta.addEventListener('click', (e) => {
        e.preventDefault();
        openModal(cta.getAttribute('data-pack') || '');
      });
    });
    overlay.querySelectorAll('[data-pm-close]').forEach((b) => b.addEventListener('click', closeModal));

    const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const prenom = (fd.get('prenom') as string || '').trim();
      const nom_famille = (fd.get('nom_famille') as string || '').trim();
      const email = (fd.get('email') as string || '').trim();
      const telephone = (fd.get('telephone') as string || '').trim();
      form.querySelectorAll('.is-invalid').forEach((el) => el.classList.remove('is-invalid'));
      let bad = '';
      if (!prenom) bad = 'prenom';
      else if (!nom_famille) bad = 'nom_famille';
      else if (!EMAIL.test(email)) bad = 'email';
      else if (telephone.replace(/\D/g, '').length < 9) bad = 'telephone';
      if (bad) {
        const f = form.querySelector(`[name="${bad}"]`) as HTMLElement;
        f?.classList.add('is-invalid'); f?.focus();
        elStatus.textContent = 'Vérifie ce champ.'; elStatus.className = 'pm-status is-error';
        return;
      }
      const btn = form.querySelector('.pm-submit') as HTMLButtonElement;
      btn.disabled = true;
      elStatus.textContent = 'Envoi…'; elStatus.className = 'pm-status';
      try {
        const res = await fetch(form.dataset.webhook || '', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            nom: `${prenom} ${nom_famille}`.trim(),
            prenom, nom_famille, email, telephone,
            message: (fd.get('message') as string || '') || `(Demande pack ${elPack.value})`,
            pack: elPack.value,
            source: 'pricing-modal',
          }),
        });
        if (!res.ok) throw new Error('http');
        elStatus.textContent = 'Reçu ! On te répond sous 24h.'; elStatus.className = 'pm-status is-ok';
        form.reset();
        setTimeout(closeModal, 1600);
      } catch {
        elStatus.textContent = 'Oups, réessaie ou écris à contact.fenx.agency@gmail.com';
        elStatus.className = 'pm-status is-error';
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>
