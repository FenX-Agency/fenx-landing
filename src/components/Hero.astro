---
import Button from './Button.astro';
import HeroShaderBg from './HeroShaderBg.astro';
---
<section id="hero" class="hero-v3" aria-label="Présentation FenX Agency">
  <HeroShaderBg />

  <div class="hero-v3__gradient" aria-hidden="true"></div>

  <div class="container hero-v3__inner">
    <div class="hero-v3__content">
      <span class="hero-v3__eyebrow" data-reveal>
        <span class="hero-v3__eyebrow-dot"></span>
        <span class="hero-v3__eyebrow-num">[01]</span>
        Studio créatif premium · IDF
      </span>

      <h1 class="hero-v3__h1" data-reveal>
        On construit des sites
        <em>premium</em>
        pour les PME
        <em>ambitieuses</em>.
      </h1>

      <p class="hero-v3__sub" data-reveal>
        Sites, vidéos IA, branding, back-office —
        livrés <em>clé en main</em>, sans intermédiaire.
      </p>

      <div class="hero-v3__ctas" data-reveal>
        <Button href="#contact" text="Démarrer un projet" openContact={true} />
        <a href="#selected-work" class="hero-v3__cta-text">
          Voir nos travaux
          <svg width="18" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true">
            <path d="M0 6h15M11 1l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
        </a>
      </div>

      <div class="hero-v3__proof" data-reveal>
        <span class="hero-v3__proof-item">
          <strong>À partir de 1990€</strong>
          <span>Pack site clé en main</span>
        </span>
        <span class="hero-v3__proof-sep" aria-hidden="true">·</span>
        <span class="hero-v3__proof-item">
          <strong>7-14 jours</strong>
          <span>Livraison</span>
        </span>
        <span class="hero-v3__proof-sep" aria-hidden="true">·</span>
        <span class="hero-v3__proof-item">
          <strong>95+ Lighthouse</strong>
          <span>Garanti</span>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-v3 {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background: var(--cosmic-bg);
    isolation: isolate;
  }

  /* Gradient overlay : assombrit le centre-bas pour lisibilité du texte */
  .hero-v3__gradient {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(ellipse at 50% 60%,
        rgba(22, 22, 28, 0.0) 0%,
        rgba(22, 22, 28, 0.4) 40%,
        rgba(22, 22, 28, 0.75) 80%,
        rgba(22, 22, 28, 0.95) 100%
      );
    pointer-events: none;
  }

  .hero-v3__inner {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 120px 32px 80px;
  }

  .hero-v3__content {
    text-align: center;
    max-width: 920px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }

  /* Eyebrow numéroté style Wibify */
  .hero-v3__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px;
    background: rgba(167, 139, 250, 0.08);
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    color: var(--lavender-bright);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
  }
  .hero-v3__eyebrow-num {
    color: var(--violet-primary);
    font-weight: 700;
  }
  .hero-v3__eyebrow-dot {
    width: 6px;
    height: 6px;
    background: var(--violet-primary);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--violet-primary);
    animation: hero-v3-pulse 2s ease-in-out infinite;
  }
  @keyframes hero-v3-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  /* H1 — taille imposante, italics emphasis style Wibify */
  .hero-v3__h1 {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2.5rem, 6.2vw, 5.25rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.04;
    color: var(--text-hover);
    margin: 0;
    text-wrap: balance;
  }
  .hero-v3__h1 em {
    font-style: italic;
    font-weight: 500;
    color: var(--violet-primary);
    font-family: 'Instrument Serif', 'Playfair Display', Georgia, serif;
    letter-spacing: -0.02em;
  }

  /* Sub */
  .hero-v3__sub {
    font-size: clamp(1.0625rem, 1.5vw, 1.3125rem);
    line-height: 1.5;
    color: var(--lavender-bright);
    max-width: 620px;
    margin: 0;
    text-wrap: balance;
  }
  .hero-v3__sub em {
    font-style: italic;
    color: var(--text-hover);
    font-family: 'Instrument Serif', 'Playfair Display', Georgia, serif;
    font-weight: 500;
  }

  /* CTAs */
  .hero-v3__ctas {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
    margin-top: 4px;
  }
  .hero-v3__cta-text {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--lavender-bright);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    padding: 12px 20px;
    border-radius: 999px;
    transition: color 200ms, background 200ms, transform 200ms;
  }
  .hero-v3__cta-text:hover,
  .hero-v3__cta-text:focus-visible {
    color: var(--text-hover);
    background: rgba(167, 139, 250, 0.08);
  }
  .hero-v3__cta-text svg {
    transition: transform 200ms;
  }
  .hero-v3__cta-text:hover svg {
    transform: translateX(4px);
  }

  /* Proof bar — inspired Wibify social proof */
  .hero-v3__proof {
    margin-top: 16px;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 14px 22px;
    background: rgba(28, 28, 46, 0.5);
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    backdrop-filter: blur(8px);
    flex-wrap: wrap;
    justify-content: center;
  }
  .hero-v3__proof-item {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .hero-v3__proof-item strong {
    color: var(--text-hover);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0;
    text-transform: none;
  }
  .hero-v3__proof-sep {
    color: var(--text-dim);
    font-size: 14px;
  }

  /* Reveal animation */
  .hero-v3__content [data-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 900ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hero-v3__content [data-reveal].is-revealed {
    opacity: 1;
    transform: translateY(0);
  }
  .hero-v3__content [data-reveal]:nth-child(1) { transition-delay: 100ms; }
  .hero-v3__content [data-reveal]:nth-child(2) { transition-delay: 250ms; }
  .hero-v3__content [data-reveal]:nth-child(3) { transition-delay: 450ms; }
  .hero-v3__content [data-reveal]:nth-child(4) { transition-delay: 650ms; }
  .hero-v3__content [data-reveal]:nth-child(5) { transition-delay: 850ms; }

  /* Mobile */
  @media (max-width: 768px) {
    .hero-v3__inner {
      padding: 96px 20px 60px;
    }
    .hero-v3__content {
      gap: 22px;
    }
    .hero-v3__h1 {
      font-size: clamp(2rem, 9vw, 3rem);
    }
    .hero-v3__sub {
      font-size: 1rem;
    }
    .hero-v3__ctas {
      flex-direction: column;
      gap: 14px;
      width: 100%;
    }
    .hero-v3__ctas > * {
      width: 100%;
      max-width: 320px;
      justify-content: center;
    }
    .hero-v3__proof {
      flex-direction: column;
      gap: 10px;
      padding: 16px 20px;
    }
    .hero-v3__proof-sep {
      display: none;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .hero-v3__content [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
    }
    .hero-v3__eyebrow-dot {
      animation: none !important;
    }
  }
</style>
