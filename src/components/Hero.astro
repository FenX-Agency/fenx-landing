---
import Button from './Button.astro';
import HeroShaderBg from './HeroShaderBg.astro';
import HeroOrbit3D from './HeroOrbit3D.astro';
---
<section id="hero" class="hero-v3" aria-label="Présentation FenX Agency">
  <HeroShaderBg />
  <HeroOrbit3D />

  <div class="hero-v3__gradient" aria-hidden="true"></div>

  {/* Décorations asymétriques style Wibify */}
  <span class="hero-v3__corner hero-v3__corner--tr" aria-hidden="true">
    <span class="hero-v3__corner-dot"></span>
    FENX · 2026
  </span>
  <span class="hero-v3__corner hero-v3__corner--bl" aria-hidden="true">
    <span>SCROLL</span>
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
      <path d="M7 1v12M2 8l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </span>

  <div class="hero-v3__inner">
    <div class="hero-v3__content">
      <span class="hero-v3__eyebrow" data-reveal>
        <span class="hero-v3__eyebrow-line" aria-hidden="true"></span>
        <span class="hero-v3__eyebrow-num">[01]</span>
        <span>STUDIO IA-NATIVE · IDF</span>
      </span>

      <h1 class="hero-v3__h1" data-reveal>
        Du <em>digital</em><br />
        qui se <em>voit</em>.<br />
        Pour les <em>PME</em>.
      </h1>

      <p class="hero-v3__sub" data-reveal>
        Sites premium, vidéos IA pour réseaux sociaux, branding complet.<br />
        <strong>Sept jours.</strong> À partir de <strong>1990€</strong>.
      </p>

      <div class="hero-v3__ctas" data-reveal>
        <Button href="#contact" text="Démarrer un projet" openContact={true} />
        <a href="#selected-work" class="hero-v3__cta-text">
          <span class="hero-v3__cta-marker" aria-hidden="true"></span>
          Voir ce qu'on a livré
        </a>
      </div>

      {/* Social proof badges style Wibify */}
      <ul class="hero-v3__badges" data-reveal aria-label="Indicateurs">
        <li class="hero-v3__badge">
          <span class="hero-v3__badge-icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor"><path d="M7 0l1.8 4.4 4.7.4-3.6 3.1 1.1 4.6L7 10l-4 2.5 1.1-4.6L.5 4.8l4.7-.4L7 0z"/></svg>
          </span>
          <strong>5+</strong> projets livrés
        </li>
        <li class="hero-v3__badge">
          <span class="hero-v3__badge-icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="7" cy="7" r="5.5"/><path d="M7 3v4l2.5 1.5"/></svg>
          </span>
          <strong>7 jours</strong> délai moyen
        </li>
        <li class="hero-v3__badge">
          <span class="hero-v3__badge-icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 7l3 3 7-7"/></svg>
          </span>
          <strong>95+</strong> Lighthouse garanti
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .hero-v3 {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background: var(--cosmic-bg);
    isolation: isolate;
  }

  /* Gradient overlay : focus à gauche pour lisibilité texte */
  .hero-v3__gradient {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: linear-gradient(90deg,
      rgba(22, 22, 28, 0.85) 0%,
      rgba(22, 22, 28, 0.65) 35%,
      rgba(22, 22, 28, 0.3) 55%,
      rgba(22, 22, 28, 0.0) 75%
    );
    pointer-events: none;
  }

  .hero-v3__corner {
    position: absolute;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--text-muted);
    text-transform: uppercase;
  }
  .hero-v3__corner--tr {
    top: 32px;
    right: 32px;
  }
  .hero-v3__corner-dot {
    width: 6px;
    height: 6px;
    background: var(--violet-primary);
    border-radius: 50%;
    box-shadow: 0 0 12px var(--violet-primary);
    animation: hero-v3-pulse 2s ease-in-out infinite;
  }
  .hero-v3__corner--bl {
    left: 32px;
    bottom: 32px;
    color: var(--lavender-bright);
    animation: hero-v3-bounce 2.4s ease-in-out infinite;
  }
  @keyframes hero-v3-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.3; transform: scale(0.75); }
  }
  @keyframes hero-v3-bounce {
    0%, 100% { transform: translateY(0); opacity: 0.7; }
    50% { transform: translateY(4px); opacity: 1; }
  }

  /* Inner : split content gauche / 3D droite */
  .hero-v3__inner {
    position: relative;
    z-index: 4;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 140px clamp(40px, 8vw, 120px) 100px;
    max-width: 100%;
  }

  .hero-v3__content {
    text-align: left;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
  }

  /* Eyebrow */
  .hero-v3__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: var(--lavender-bright);
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .hero-v3__eyebrow-line {
    display: inline-block;
    width: 36px;
    height: 1px;
    background: var(--violet-primary);
  }
  .hero-v3__eyebrow-num {
    color: var(--violet-primary);
    font-weight: 700;
  }

  /* H1 court & impactful (Wibify style) */
  .hero-v3__h1 {
    font-family: 'Switzer', 'Inter', sans-serif;
    font-size: clamp(3rem, 8.5vw, 7.5rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 0.95;
    color: var(--text-hover);
    margin: 0;
    text-wrap: balance;
  }
  .hero-v3__h1 em {
    font-style: italic;
    font-weight: 400;
    color: var(--violet-primary);
    font-family: 'Instrument Serif', 'Playfair Display', Georgia, serif;
    letter-spacing: -0.02em;
    position: relative;
  }
  /* Underline animation sur les <em> au reveal */
  .hero-v3__h1 em::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0.05em;
    width: 100%;
    height: 2px;
    background: var(--violet-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1200ms cubic-bezier(0.16, 1, 0.3, 1) 1400ms;
  }
  .hero-v3__h1.is-revealed em::after {
    transform: scaleX(1);
  }

  /* Sub */
  .hero-v3__sub {
    font-size: clamp(1.0625rem, 1.45vw, 1.25rem);
    line-height: 1.55;
    color: var(--lavender-bright);
    max-width: 540px;
    margin: 0;
  }
  .hero-v3__sub strong {
    color: var(--text-hover);
    font-weight: 700;
  }

  /* CTAs */
  .hero-v3__ctas {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
    margin-top: 8px;
  }
  .hero-v3__cta-text {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--lavender-bright);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    padding: 12px 0;
    border-bottom: 1px solid transparent;
    transition: color 220ms, border-color 220ms;
  }
  .hero-v3__cta-marker {
    width: 8px;
    height: 8px;
    background: var(--violet-primary);
    display: inline-block;
    border-radius: 2px;
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 320ms;
  }
  .hero-v3__cta-text:hover {
    color: var(--text-hover);
    border-color: var(--violet-primary);
  }
  .hero-v3__cta-text:hover .hero-v3__cta-marker {
    transform: rotate(45deg) scale(1.3);
    box-shadow: 0 0 14px var(--violet-primary);
  }

  /* Social proof badges (Wibify-style) */
  .hero-v3__badges {
    list-style: none;
    margin: 32px 0 0;
    padding: 24px 0 0;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
    max-width: 720px;
  }
  .hero-v3__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .hero-v3__badge strong {
    color: var(--text-hover);
    font-weight: 700;
    margin-right: 2px;
  }
  .hero-v3__badge-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: rgba(167, 139, 250, 0.12);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    color: var(--violet-primary);
  }

  /* Reveal cascade */
  .hero-v3 [data-reveal] {
    opacity: 0;
    transform: translateY(48px);
    transition: opacity 1100ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 1100ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hero-v3__content [data-reveal]:nth-child(1) { transition-delay: 150ms; }
  .hero-v3__content [data-reveal]:nth-child(2) { transition-delay: 300ms; }
  .hero-v3__content [data-reveal]:nth-child(3) { transition-delay: 500ms; }
  .hero-v3__content [data-reveal]:nth-child(4) { transition-delay: 700ms; }
  .hero-v3__content [data-reveal]:nth-child(5) { transition-delay: 900ms; }
  .hero-v3 [data-reveal].is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* Mobile responsive */
  @media (max-width: 900px) {
    .hero-v3__corner--tr {
      top: 20px;
      right: 20px;
      font-size: 10px;
    }
    .hero-v3__corner--bl {
      left: 20px;
      bottom: 20px;
      font-size: 10px;
    }
    .hero-v3__inner {
      padding: 110px 24px 80px;
    }
    .hero-v3__gradient {
      background: linear-gradient(180deg,
        rgba(22, 22, 28, 0.0) 0%,
        rgba(22, 22, 28, 0.4) 60%,
        rgba(22, 22, 28, 0.85) 100%
      );
    }
    .hero-v3__h1 {
      font-size: clamp(2.5rem, 12vw, 4.5rem);
    }
    .hero-v3__sub {
      font-size: 1rem;
    }
    .hero-v3__ctas {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
      width: 100%;
    }
    .hero-v3__ctas > * {
      width: 100%;
      max-width: 360px;
    }
    .hero-v3__badges {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
      padding: 20px 0 0;
      margin-top: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-v3 [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
    }
    .hero-v3__h1 em::after {
      transform: scaleX(1) !important;
    }
    .hero-v3__corner-dot,
    .hero-v3__corner--bl {
      animation: none !important;
    }
  }
</style>
