---
import Button from './Button.astro';
import HeroVisualMockup from './HeroVisualMockup.astro';
---
<section id="hero" class="hero" aria-label="Présentation FenX">
  <div class="hero-stars" aria-hidden="true">
    <span class="star" style="width: 2px; height: 2px; top: 25%; left: 15%; animation-delay: 0s;"></span>
    <span class="star" style="width: 1.5px; height: 1.5px; top: 18%; left: 35%; animation-delay: 0.5s;"></span>
    <span class="star" style="width: 1.5px; height: 1.5px; top: 32%; right: 28%; animation-delay: 1s;"></span>
    <span class="star" style="width: 2px; height: 2px; top: 70%; left: 22%; animation-delay: 1.5s;"></span>
    <span class="star" style="width: 1.5px; height: 1.5px; top: 78%; right: 18%; animation-delay: 2s;"></span>
    <span class="star" style="width: 2px; height: 2px; top: 12%; right: 40%; animation-delay: 1.3s;"></span>
  </div>

  <div class="container hero-stack">
    <div class="hero-content hero-content-center">
      <span class="hero-badge hero-reveal" style="--reveal-delay: 0ms">
        <span class="hero-badge-tag">Nouveau</span>
        <span class="hero-badge-text">✨ Sites IA pour TPE locales <span class="hero-badge-emph">en 7 jours</span></span>
        <svg class="hero-badge-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M12.97 3.97a.75.75 0 0 1 1.06 0l7.5 7.5a.75.75 0 0 1 0 1.06l-7.5 7.5a.75.75 0 1 1-1.06-1.06l6.22-6.22H3a.75.75 0 0 1 0-1.5h16.19l-6.22-6.22a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
        </svg>
      </span>
      <h1 class="hero hero-reveal" style="--reveal-delay: 140ms">
        PLUS DE <span class="hero-h1-accent">CLIENTS.</span><br />EN <span class="hero-h1-accent-2">7 JOURS.</span>
      </h1>
      <p class="hero-sub hero-reveal" style="--reveal-delay: 280ms">Un site qui fait le boulot — design, SEO local, autonomie. À partir de 990€, livré clé en main.</p>
      <div class="hero-ctas hero-reveal" style="--reveal-delay: 420ms">
        <Button href="mailto:anthony.grupposo@gmail.com?subject=Intéressé par FenX" text="Discuter projet" />
        <a href="https://demo-wok.fenx-agency.com" target="_blank" rel="noopener" class="btn-text">Voir une démo →</a>
      </div>
    </div>
    <div class="hero-visual hero-visual-below hero-reveal" style="--reveal-delay: 560ms">
      <HeroVisualMockup />
    </div>
  </div>
</section>
