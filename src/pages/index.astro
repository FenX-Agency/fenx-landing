---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SelectedWork from '../components/v3/SelectedWork.astro';
import Services from '../components/v3/Services.astro';
import Pricing from '../components/v3/Pricing.astro';
import Process from '../components/v3/Process.astro';
import Contact from '../components/v3/Contact.astro';
import FAQ from '../components/v3/FAQ.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
---
<Layout>
