---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SelectedWork from '../components/v3/SelectedWork.astro';
import Services from '../components/v3/Services.astro';
import Process from '../components/v3/Process.astro';
import Studio from '../components/v3/Studio.astro';
import Contact from '../components/v3/Contact.astro';
import Founder from '../components/v3/Founder.astro';
import FAQ from '../components/v3/FAQ.astro';
import Stack from '../components/v3/Stack.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
---
<Layout>
  <Header />
  <main id="main">
    <Hero />              {/* [01] */}
    <SelectedWork />      {/* [02] */}
    <Services />          {/* [03] */}
    <Process />           {/* [04] */}
    <Studio />            {/* [05] */}
    <Contact />           {/* [06] */}
    <Founder />           {/* [07] */}
    <FAQ />               {/* [08] */}
    <Stack />             {/* [09] */}
  </main>
  <Footer />
  <ContactModal />
</Layout>
