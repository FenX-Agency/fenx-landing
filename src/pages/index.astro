  <main id="main">
    <Hero />              {/* [01] */}
    <SelectedWork />      {/* [02] */}
    <Services />          {/* [03] */}
    <Pricing />           {/* [04] — NEW Branding agent */}
    <Process />           {/* [05] */}
    <FAQ />               {/* [06] — moved before Contact (UX-UI reco : objections puis action) */}
